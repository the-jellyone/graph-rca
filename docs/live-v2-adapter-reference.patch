+"""Readable terminal output. Complete measurements remain in the event file."""
+import re
+
+NAMES = {'resource/payment':'payment service', 'resource/orders':'orders service',
+         'resource/catalogue-db':'catalogue database', 'resource/carts':'carts service',
+         'edge/orders/payment':'orders-to-payment connection', 'NO_FAULT':'no fault', 'DEFER':'diagnosis deferred'}
+
+
+def clean(value):
+    return re.sub(r'[\x00-\x1f\x7f]', ' ', str(value))
+
+
+def render(kind, value):
+    if kind == 'ready':
+        return 'Controller ready. Rolling collection is active. Select a policy in chat and a case in the injector.' if value.get('collection','').startswith('rolling_early_') else 'Controller ready. Select a policy in chat and a case in the injector.'
+    if kind == 'rolling':
+        return clean(value['message'])
+    if kind == 'monitor':
+        stages = {'healthy_baseline':'Checking healthy checkout traffic', 'settling':'Waiting for the injected condition to settle', 'collecting':'Collecting the incident measurements'}
+        return f"{stages.get(value['stage'], clean(value['stage']))}, {value.get('seconds', 0)} seconds."
+    if kind == 'probe':
+        action = value['action']
+        if action in ('STOP','DEFER'):
+            return 'Agent finished choosing probes.' if action == 'STOP' else 'Agent deferred the diagnosis.'
+        family, resource, _ = action.split('/')
+        label = {'cpu':'CPU load','memory':'memory use','status':'container status','latency':'checkout latency','request_errors':'checkout failures','logs':'error logs'}.get(family, family)
+        prefix='Refresh' if value.get('refresh') else 'Probe'
+        return f"{prefix}: {resource} {label} = {value.get('response','unavailable').replace('_',' ').lower()}. Credits used: {value.get('credits',0)}. Choice time: {value.get('decision_latency_ms',0):.1f} ms."
+    if kind == 'diagnosis':
+        decision = value['decision']
+        return f"Diagnosis: {NAMES.get(decision['prediction'], clean(decision['prediction']))}. Model confidence: {decision['confidence']:.1%}. Probes: {value['probes']}. Credits: {value['credits']}."
+    if kind == 'graph':
+        names = ', '.join(clean(v) for v in value['anomalies']) or 'none'
+        return f"GraphRAG retrieved {value['dependencies']} service dependencies from Neo4j. Observed anomalies: {names}."
+    if kind == 'repair':
+        return {'owned_repair_started':'Applying the owned demo repair.', 'withheld':'Repair withheld. The diagnosis or purchased evidence did not justify it.', 'no_injected_fault':'No injected fault to repair.'}.get(value['stage'], clean(value['stage']))
+    if kind == 'cleanup':
+        return 'Cleaning up the injector\'s own fault. This does not count as successful agent repair.'
+    if kind == 'complete':
+        if value.get('resolved'):
+            return 'Repair verified. Five consecutive checkouts passed and the lab recovered.'
+        if value.get('healthy_control_confirmed'):
+            return 'Healthy control verified. Five consecutive checkouts passed.'
+        if value.get('cleanup_confirmed'):
+            return 'Lab cleanup verified. Successful agent repair was not confirmed.'
+        return f"Run {clean(value.get('status','finished')).lower()}: {clean(value.get('error','no recovery confirmation'))}"
+    if kind in ('failure','request_failed'):
+        return 'Run failed: ' + clean(value.get('error', value.get('reason','unknown error')))
+    if kind == 'policy':
+        return f"Policy selected: {clean(value['policy'])}, seed {value.get('seed',11)}. Applies to the next incident."
+    if kind == 'stopped':
+        return 'Controller stopped at a safe boundary.'
+    if kind == 'recovery':
+        return 'Persisted recovery completed.'
+    return clean(kind.replace('_',' '))
