+++ b/team-graph-rca/src/rca_live/controller.py
@@ -0,0 +1,230 @@
+"""One lab owner collects, investigates, repairs and checks recovery."""
+import json
+import os
+import subprocess
+from pathlib import Path
+from time import monotonic, sleep
+from uuid import uuid4
+import requests
+import yaml
+from rca_investigation.capture import capture_lease, RecoveryFailed
+from rca_investigation.capture_v2 import collect_window
+from rca_investigation.backends.container_stats import ContainerStatsCollector
+from rca_investigation.dataset import atomic_json
+from rca_investigation.faults_v2 import AdaptiveLabDriver
+from rca_investigation.raw_schedule import settle_states
+from rca_investigation.workload_v2 import CheckoutWorkload
+from .agents import Agents, POLICIES
+from .bus import emit, pending, server_lock
+from .repair import CASES, OwnedFault, repair_allowed
+
+
+def validate_request(item):
+    allowed = {'id', 'command', 'case', 'policy', 'seed', 'hybrid'}
+    if set(item) - allowed or item.get('command') not in ('run', 'policy', 'stop'):
+        raise ValueError('unsupported controller command')
+    if item.get('policy', 'voi') not in POLICIES or item.get('seed', 11) not in (11, 22, 33, 44, 55):
+        raise ValueError('undeclared policy or seed')
+    if type(item.get('hybrid', False)) is not bool:
+        raise ValueError('invalid hybrid flag')
+    if item['command'] == 'run' and item.get('case') not in CASES:
+        raise ValueError('unsupported case; broader v3 faults need their separate model')
+
+
+def healthy_requests(raw):
+    rows = [r for r in raw['requests'] if r['operation'] == 'checkout']
+    return len(rows) >= 20 and all(r['http_status'] == 201 and r['outcome'] == 'completed' for r in rows) and not raw['workload_errors']
+
+
+def foreign_collectors():
+    # A multi-incident controller briefly releases capture.lock between slots.
+    # Refuse those gaps as well, so the next pilot cannot lose its lab lease.
+    if os.name == 'nt':
+        script = "@(Get-CimInstance Win32_Process | Where-Object { $_.Name -match '^python' -and $_.CommandLine -match 'run_v3_[A-Za-z_]+[.]py|run_adaptive_phases[.]py|run_adaptive_sweep[.]py|rca_investigation[.]capture' } | Select-Object -ExpandProperty ProcessId) | ConvertTo-Json -Compress"
+        response = subprocess.run(['powershell.exe', '-NoProfile', '-NonInteractive', '-Command', script],
+                                  capture_output=True, text=True, timeout=15, check=True)
+        value = json.loads(response.stdout or '[]')
+        return value if isinstance(value, list) else [value]
+    response = subprocess.run(['ps', '-eo', 'pid,args'], capture_output=True, text=True, timeout=10, check=True)
+    return [int(row.split()[0]) for row in response.stdout.splitlines()
+            if any(name in row for name in ('run_v3_', 'run_adaptive_phases.py', 'run_adaptive_sweep.py', 'rca_investigation.capture'))]
+
+
+class Controller:
+    def __init__(self, artifacts, output, emit_event=None):
+        self.artifacts, self.output = Path(artifacts).resolve(), Path(output).resolve()
+        self.agents = Agents(self.artifacts)
+        registry = yaml.safe_load(Path('configs/resources_sockshop_v2.yaml').read_text())['resources']
+        self.registry = {r: registry[r] for r in self.agents.config.values['resources']}
+        self.shared = self.artifacts / 'runs/adaptive_v2/lab'
+        self.driver = AdaptiveLabDriver(self.agents.topology, self.artifacts)
+        self.stats = ContainerStatsCollector(self.registry)
+        self.emit = emit_event or (lambda kind, value: emit(self.output, kind, value))
+        from .graph import GraphRAG
+        self.graph_factory = lambda: GraphRAG(self.artifacts,self.agents.topology)
+
+    def identities(self):
+        self.driver.resolve()
+        for resource, item in self.registry.items():
+            if self.driver.ids[resource] != item['container_id']:
+                raise RuntimeError('v2 registry container changed; live demo needs an explicitly verified new registry')
+            payload, _ = self.driver.command(['inspect', item['container_id']])
+            settings = json.loads(payload)[0]['HostConfig']
+            if settings['Memory'] != item['memory_limit_bytes']:
+                raise RuntimeError('trained memory limit changed')
+            quota, period = settings['CpuQuota'], settings['CpuPeriod']
+            cores = quota / (period or 100000) if quota > 0 else settings.get('NanoCpus', 0) / 1e9
+            if cores <= 0:
+                from os import cpu_count
+                info, _ = self.driver.command(['info', '--format', '{{json .NCPU}}'])
+                cores = json.loads(info)
+            if abs(cores - item['cpu_quota_cores']) > .001:
+                raise RuntimeError('trained CPU quota changed')
+
+    def verify_health(self, workload, fault):
+        deadline = monotonic() + 90
+        checks, errors = [], []
+        while monotonic() < deadline:
+            try:
+                states_ok = all(v == 'running' for v in self.driver.states().values())
+                proxy_ok = self.driver.proxy_control()['delay_ms'] == 0
+                workload.prepare()
+                row = workload.checkout()
+                okay = states_ok and proxy_ok and row['http_status'] == 201 and row['outcome'] == 'completed'
+                memory_ok = True
+                if fault.intent and fault.intent['kind'] == 'memory':
+                    sample = next(r for r in self.stats.poll() if r['resource_id'] == 'carts')
+                    memory_ok = sample['availability'] == 'OK' and sample['memory_bytes'] <= fault.intent['baseline_memory_bytes'] + max(16 * 1024**2, self.registry['carts']['memory_limit_bytes'] * .05)
+                    row['memory_released'] = memory_ok
+                checks = checks + [row] if okay and memory_ok else []
+                if len(checks) == 5:
+                    workload.reset()
+                    return {'confirmed': True, 'consecutive_checkouts': checks, 'resources_running': True, 'proxy_delay_ms': 0}
+            except (RuntimeError, requests.RequestException) as exc:
+                checks = []
+                errors.append(type(exc).__name__)
+            sleep(2)
+        return {'confirmed': False, 'consecutive_checkouts': checks, 'errors': errors}
+
+    def run(self, item):
+        validate_request(item)
+        owner = str(uuid4())
+        directory = self.output / 'incidents' / owner
+        directory.mkdir(parents=True)
+        fault = OwnedFault(self.driver, self.registry, directory / 'recovery.json', self.shared / 'blocked-lab.json')
+        workload = CheckoutWorkload()
+        workload.measure_cart = True
+        receipt = {'incident_id': owner, 'request_id': item['id'], 'case': item['case'],
+                   'status': 'STARTED', 'identity': self.agents.identity, 'pid': os.getpid(),
+                   'mode': 'live_demo_only', 'training_or_benchmark_record': False}
+        atomic_json(directory / 'receipt.json', receipt)
+        result, repaired = None, False
+        try:
+            if foreign_collectors():
+                raise RuntimeError('another physical controller is running; live demo must wait for it to finish')
+            # Shared with both the v2 and v3 physical runners. Never reclaim another lease.
+            with capture_lease(self.shared), self.graph_factory() as rag:
+                legacy = self.artifacts / 'runs/integration_v1/captures/sockshop_v1'
+                if any((legacy / name).exists() for name in ('capture.lock', 'blocked-lab.json')):
+                    raise RecoveryFailed('legacy controller owns the lab')
+                self.identities()
+                expected = {r: 'running' for r in self.driver.topology.resources}
+                if self.driver.states() != expected or self.driver.proxy_control()['delay_ms'] != 0:
+                    raise RuntimeError('healthy lab baseline required; existing faults are not owned by this demo')
+                try:
+                    workload.prepare()
+                    self.emit('monitor', {'incident_id': owner, 'stage': 'healthy_baseline', 'seconds': 120})
+                    baseline_window, baseline = collect_window(self.driver, workload, self.stats, self.registry, ingestion_seconds=0, expected_states=expected)
+                    if not healthy_requests(baseline):
+                        raise RuntimeError('healthy baseline checkout coverage or success failed')
+                    atomic_json(directory / 'baseline.json', {'window': baseline_window, 'measurements': baseline})
+                    memory = [r for r in baseline['stats'] if r['resource_id'] == 'carts' and r['availability'] == 'OK']
+                    before = memory[-1]['memory_bytes'] if memory else None
+                    fault.inject(item['case'], owner, before)
+                    if fault.intent and fault.intent['kind'] == 'stop':
+                        expected[fault.intent['resource']] = 'exited'
+                    self.emit('monitor', {'incident_id': owner, 'stage': 'settling', 'seconds': 30})
+                    settle_states(self.driver, expected, 30)
+                    self.emit('monitor', {'incident_id': owner, 'stage': 'collecting', 'seconds': 120})
+                    window, raw = collect_window(self.driver, workload, self.stats, self.registry, interval=.1, expected_states=expected)
+                    atomic_json(directory / 'window.json', {'window': window, 'measurements': raw})
+                    context = rag.publish(owner,window,raw,self.registry,self.agents)
+                    atomic_json(directory/'graph-context.json',context)
+                    self.emit('graph',{'dependencies':len(rag.topology.calls),'anomalies':[r['name'] for r in context['anomalies']],
+                                      'stage':'retrieved','incident_id':owner})
+                    result = self.agents.investigate(owner, window, raw, self.registry,
+                        item.get('policy', 'voi'), item.get('seed', 11), item.get('hybrid', False), self.emit,graph=rag,
+                        mode='live_graph_guided_r1')
+                    atomic_json(directory / 'diagnosis.json', result)
+                    if repair_allowed(result, fault.intent):
+                        self.emit('repair', {'incident_id': owner, 'stage': 'owned_repair_started', 'cause': result['decision']['prediction']})
+                        recovery = fault.restore()
+                        repaired = not recovery.get('already_restored', False)
+                    elif fault.intent:
+                        self.emit('repair', {'incident_id': owner, 'stage': 'withheld', 'reason': 'diagnosis or paid evidence does not justify an owned repair'})
+                    else:
+                        self.emit('repair', {'incident_id': owner, 'stage': 'no_injected_fault'})
+                finally:
+                    # Cleanup is independent of the diagnostic outcome. Never call it successful agent repair.
+                    if fault.intent and fault.intent['phase'] != 'restored':
+                        self.emit('cleanup', {'incident_id': owner, 'stage': 'restore_owned_injection'})
+                        fault.restore()
+                    health = self.verify_health(workload, fault)
+                    receipt['health'] = health
+                    if not health['confirmed']:
+                        raise RecoveryFailed('independent checkout and resource recovery checks failed')
+                    fault.confirmed(health)
+                    rag.graph.query("MATCH (n {lab_project:'rca-lab',live_incident_id:$incident}) SET n.anomaly_flag=false,n.anomaly_type=null,n.anomaly_since=null,n.status='healthy',n.live_recovery_confirmed=true",
+                                    params={'incident':owner})
+                    rag.graph.query("MATCH (a {lab_project:'rca-lab',live_incident_id:$incident})-[r:TRIGGERS]->() DELETE r",params={'incident':owner})
+                    receipt.update(status='COMPLETE', agent_repair=repaired,
+                        resolved=bool(repaired and health['confirmed']), cleanup_confirmed=True)
+                    if result:
+                        receipt['diagnosis'] = result['decision']
+                        receipt['healthy_control_confirmed'] = not fault.intent and result['decision']['prediction'] == 'NO_FAULT'
+        except BaseException as exc:
+            receipt.update(status='FAILED', error=f'{type(exc).__name__}: {exc}', resolved=False)
+            self.emit('failure', {'incident_id': owner, 'error': receipt['error']})
+            raise
+        finally:
+            workload.close()
+            atomic_json(directory / 'receipt.json', receipt)
+            self.emit('complete', receipt)
+        return receipt
+
+    def serve(self, once=False):
+        policy = {'policy': 'voi', 'seed': 11, 'hybrid': False}
+        with server_lock(self.output):
+            self.emit('ready', {'policy': policy, 'identity': self.agents.identity, 'output': str(self.output)})
+            while True:
+                entries = list(pending(self.output))
+                # Re-read after each incident. A stop requested during collection
+                # takes priority over any later queued injection at that boundary.
+                entries.sort(key=lambda entry: entry[1].get('command') != 'stop')
+                for path, item in entries[:1]:
+                    processed = self.output / 'processed' / path.name
+                    processed.parent.mkdir(exist_ok=True)
+                    # Move before handling, so a crashed run cannot inject a second time.
+                    path.rename(processed)
+                    try:
+                        validate_request(item)
+                        if item['command'] == 'stop':
+                            self.emit('stopped', {'request_id': item['id']})
+                            return
+                        if item['command'] == 'policy':
+                            policy = {k: item.get(k, policy[k]) for k in policy}
+                            self.emit('policy', policy)
+                        else:
+                            self.run({**policy, **item})
+                    except KeyboardInterrupt:
+                        raise
+                    except Exception as exc:
+                        self.emit('request_failed', {'request_id': item['id'], 'reason': str(exc)})
+                        marker = self.shared / 'blocked-lab.json'
+                        if marker.exists():
+                            saved = json.loads(marker.read_text())
+                            if saved.get('live_demo') and Path(saved.get('journal', '')).is_relative_to(self.output):
+                                raise
+                    if once:
+                        return
+                sleep(.25)
