+"""Check real Neo4j dependency retrieval, paid evidence and all four agents."""
+from pathlib import Path
+import argparse
+import json
+import sys
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'src'))
+from rca_live.bootstrap import activate
+activate()
+from rca_live.agents import Agents, POLICIES
+from rca_live.graph import GraphRAG
+from rca_investigation.capture import capture_lease
+from rca_investigation.capture_store import read_raw
+from rca_investigation.dataset import atomic_json, load_private_label
+from rca_investigation.experiment import label_name
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--artifacts',required=True)
+    args = parser.parse_args()
+    root = Path(args.artifacts)
+    agents = Agents(root)
+    dataset = root/agents.config.values['paths']['dataset']
+    manifest = json.loads((dataset/'splits.json').read_text())
+    samples = {}
+    for identifier in manifest['splits']['validation']:
+        samples.setdefault(label_name(load_private_label(dataset/identifier)),identifier)
+    checks=[]
+    with capture_lease(root/'runs/adaptive_v2/lab'),GraphRAG(root,agents.topology) as rag:
+        for cause,identifier in sorted(samples.items()):
+            public,_ = read_raw(root/'datasets/raw_v2c'/identifier,public_only=True)
+            raw,window = public['measurements.json'],public['public.json']
+            context = rag.publish(identifier,window,raw,raw['registry'],agents)
+            for policy in POLICIES:
+                result = agents.investigate(identifier,window,raw,raw['registry'],policy=policy,graph=rag,mode='graph_saved_validation_check')
+                row={'case':cause,'policy':policy,'prediction':result['decision']['prediction'],
+                     'graph_dependencies':len(rag.topology.calls),'graph_alerts':[r['name'] for r in context['anomalies']],
+                     'probes':result['probes'],'credits':result['credits'],'graph_guided':result['graph_guided'],
+                     'packets_from_neo4j':True,'physical_injections':0}
+                checks.append(row)
+                print(json.dumps(row),flush=True)
+        # This engineering replay does not leave historical anomalies active.
+        rag.graph.query("MATCH (n {lab_project:'rca-lab'}) SET n.anomaly_flag=false,n.anomaly_type=null,n.anomaly_since=null,n.status='unknown',n.live_incident_id=null")
+        rag.graph.query("MATCH (a {lab_project:'rca-lab'})-[r:TRIGGERS]->() DELETE r")
+    atomic_json('runs/live_demo_verification/graph-validation.json',{'passed':True,'checks':checks,
+        'benchmark_equivalent':False,'training':False,'reserved_reads':False,'physical_injections':0})
+
+
+if __name__ == '__main__':
+    main()
