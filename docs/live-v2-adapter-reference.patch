+def test_progressive_budget_and_history_persist_across_graph_updates(agents):
+    session=session_fixture(agents)
+    incident=incident_for(agents,'early',{'window_start':stamp(0),'window_end':stamp(5)})
+    p=packet(agents,5,'status/payment/v2')
+    graph=FakeGraph(agents,[p])
+    assert session.advance(incident,graph,{'status/payment/v2'},stamp(5)) is None
+    assert session.ledger.credits==1 and len(session.history)==1
+    incident2=incident_for(agents,'early',{'window_start':stamp(0),'window_end':stamp(10)})
+    graph2=FakeGraph(agents,[packet(agents,10,'cpu/payment/v2')])
+    result=session.advance(incident2,graph2,{'cpu/payment/v2'},stamp(10))
+    assert result['decision']['prediction']=='resource/payment'
+    assert result['credits']==3 and result['probes']==2
+    assert [p['window_end'] for p in result['packets']]==[stamp(5),stamp(10)]
