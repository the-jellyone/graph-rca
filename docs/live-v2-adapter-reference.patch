@@ -0,0 +1,81 @@
+"""Fresh physical smoke tests, after all other physical controllers release the lab."""
+from pathlib import Path
+import argparse
+import json
+import sys
+import time
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
+from rca_live.bootstrap import activate
+activate()
+from rca_live.bus import emit, server_lock
+from rca_live.controller import Controller, foreign_collectors
+from rca_live.narration import Narrator
+from rca_investigation.dataset import atomic_json
+from uuid import uuid4
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--artifacts', required=True)
+    parser.add_argument('--env-file')
+    parser.add_argument('--wait-for-lab', action='store_true')
+    parser.add_argument('--max-wait-minutes', type=int, default=180)
+    args = parser.parse_args()
+    root = Path(args.artifacts).resolve()
+    output = Path('runs/live_demo_verification/physical').resolve()
+    shared = root / 'runs/adaptive_v2/lab'
+    deadline = time.monotonic() + args.max_wait_minutes * 60
+    quiet_since, last = None, None
+    while True:
+        pids = foreign_collectors()
+        busy = pids or any((shared / name).exists() for name in ('capture.lock','blocked-lab.json'))
+        if not busy:
+            quiet_since = quiet_since or time.monotonic()
+            if time.monotonic() - quiet_since >= 30:
+                break
+        else:
+            quiet_since = None
+        if not args.wait_for_lab:
+            raise RuntimeError('exclusive live lab slot required')
+        status = {'waiting_for_lab': bool(busy), 'physical_controllers': pids}
+        if status != last:
+            print(json.dumps(status), flush=True)
+            last = status
+        if time.monotonic() >= deadline:
+            raise RuntimeError('live lab wait expired without taking ownership')
+        time.sleep(10)
+    slots = [('voi', name) for name in ('healthy','catalogue-db','orders','payment-cpu','payment-delay','carts-memory')]
+    slots += [('dp','payment-delay'), ('expected-sarsa','orders'), ('two-step-sarsa','catalogue-db')]
+    summary_path = output / 'verification.json'
+    report = json.loads(summary_path.read_text()) if summary_path.exists() else {'slots':{}, 'complete':False}
+    with server_lock(output):
+        controller = Controller(root, output)
+        for policy, case in slots:
+            key = policy + '/' + case
+            if key in report['slots']:
+                receipt_path = Path(report['slots'][key]['receipt'])
+                saved = json.loads(receipt_path.read_text())
+                if saved['status'] == 'COMPLETE' and saved.get('cleanup_confirmed'):
+                    continue
+                raise RuntimeError('a prior verified receipt changed')
+            print(json.dumps({'live_check':key,'stage':'start'}),flush=True)
+            receipt = controller.run({'id':str(uuid4()), 'command':'run', 'case':case, 'policy':policy})
+            passed = receipt.get('healthy_control_confirmed') if case == 'healthy' else receipt.get('resolved')
+            path = output/'incidents'/receipt['incident_id']/'receipt.json'
+            report['slots'][key] = {'passed':bool(passed), 'receipt':str(path)}
+            atomic_json(summary_path, report)
+            if not passed:
+                raise AssertionError('physical agent diagnosis or owned repair did not pass: '+key)
+            if args.env_file and Path(args.env_file).exists():
+                answer = Narrator(args.env_file).describe(receipt)
+                atomic_json(output/'narration'/(receipt['incident_id']+'.json'), answer)
+                report['narration_mode'] = answer['mode']
+            print(json.dumps({'live_check':key,'stage':'verified'}),flush=True)
+    report.update(complete=True, passed=all(row['passed'] for row in report['slots'].values()),
+                  physical_incidents=len(report['slots']), training=False, reserved_reads=False)
+    atomic_json(summary_path, report)
+    print(json.dumps({'live_verification_complete':True,'report':str(summary_path)}),flush=True)
+
+
+if __name__ == '__main__':
+    main()
