+"""Fresh early-mode checks, sequentially under the same lab ownership rules."""
+from pathlib import Path
+import argparse
+import json
+import sys
+from uuid import uuid4
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'src'))
+from rca_live.bootstrap import activate
+activate()
+from rca_live.rolling_controller import RollingController
+from rca_live.bus import server_lock
+from rca_live.streaming import PROTOCOL
+from rca_live.repair import CASES
+from rca_investigation.dataset import atomic_json
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--artifacts',required=True)
+    args=parser.parse_args()
+    output=(Path('runs/early_live_sweep')/PROTOCOL['name']).resolve()
+    report={'checks':[],'complete':False,'training':False,'reserved_reads':False,'benchmark_equivalent':False,
+            'protocol':PROTOCOL,'acceptance':'Faults require correct diagnosis and verified owned repair. Healthy control permits NO_FAULT or DEFER, requires no repair and confirmed health. Integration acceptance is not accuracy promotion.'}
+    atomic_json(output/'verification.json',report)
+    with server_lock(output):
+        controller=RollingController(args.artifacts,output)
+        for policy,case in [('voi','orders'),('dp','catalogue-db'),('expected-sarsa','payment-cpu'),('two-step-sarsa','carts-memory'),('voi','payment-delay'),('voi','healthy')]:
+            print(f'Fresh check: {case} using {policy}',flush=True)
+            result=controller.run({'id':str(uuid4()),'command':'run','case':case,'policy':policy})
+            prediction=result.get('diagnosis',{}).get('prediction')
+            passed=(prediction in ('NO_FAULT','DEFER') and not result.get('agent_repair') and result.get('health',{}).get('confirmed')) if case=='healthy' else (prediction==CASES[case][0] and result.get('resolved'))
+            row={'case':case,'policy':policy,'passed':bool(passed),'incident_id':result['incident_id'],
+                 'diagnosis_seconds':result.get('diagnosis_seconds'),'repair_started_seconds':result.get('repair_started_seconds'),
+                 'repair_command_completed_seconds':result.get('repair_command_completed_seconds'),
+                 'verified_recovery_seconds':result.get('verified_recovery_seconds'),'diagnosis':result.get('diagnosis'),
+                 'diagnosis_correct':prediction==CASES[case][0],'covered':prediction!='DEFER'}
+            report['checks'].append(row)
+            atomic_json(output/'verification.json',report)
+            if not passed:
+                raise AssertionError('fresh early-mode check did not pass; retain the failed receipt')
+    report.update(complete=True,passed=all(r['passed'] for r in report['checks']))
+    atomic_json(output/'verification.json',report)
+
+
+if __name__=='__main__':
+    main()
