+"""Exercise all three terminal wrappers while the physical lab is already owned."""
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+from uuid import uuid4
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--artifacts', required=True)
+    args = parser.parse_args()
+    artifacts = Path(args.artifacts).resolve()
+    lease = artifacts / 'runs/adaptive_v2/lab/capture.lock'
+    if not lease.exists():
+        raise RuntimeError('this check requires an existing foreign lab lease')
+    lease_before = lease.read_bytes()
+    output = Path('runs/live_demo_verification') / ('bus-' + str(uuid4()))
+    output.mkdir(parents=True)
+    common = ['--agent-demo', '--output', str(output.resolve())]
+    children = []
+    handles = []
+    try:
+        for name, program, extra in [
+            ('monitor', 'pipeline/monitor.py', ['--artifacts', str(artifacts), '--once', '--collection', 'windowed']),
+            ('chat', 'pipeline/llm_chat.py', ['--no-llm', '--once', '--history'])]:
+            stream = (output / (name + '.log')).open('w')
+            handles.append(stream)
+            child = subprocess.Popen([sys.executable, program, *common, *extra],
+                                     stdout=stream, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
+            children.append(child)
+        deadline = time.monotonic() + 30
+        while not (output / 'server.lock').exists():
+            if children[0].poll() is not None or time.monotonic() > deadline:
+                raise RuntimeError('terminal 1 failed to become ready')
+            time.sleep(.1)
+        injection = subprocess.run([sys.executable, 'pipeline/fault_injector.py', *common, '--case', 'healthy'],
+            capture_output=True, text=True, timeout=10, check=True)
+        (output / 'injector.log').write_text(injection.stdout)
+        for child in children:
+            if child.wait(timeout=30):
+                raise RuntimeError('terminal process failed')
+        receipts = list((output / 'incidents').glob('*/receipt.json'))
+        receipt = json.loads(receipts[0].read_text())
+        assert receipt['status'] == 'FAILED' and any(s in receipt['error'] for s in ('owns this lab', 'blocks the lab', 'another physical controller'))
+        assert lease.read_bytes() == lease_before
+        assert not list((output / 'incidents').glob('*/window.json'))
+        assert not (output / 'server.lock').exists()
+        assert list((output / 'narration').glob('*.json'))
+        (output / 'verification.json').write_text(json.dumps({'passed': True, 'mode': 'foreign_lease_rejection',
+            'terminal_processes': 3, 'physical_injections': 0, 'foreign_lease_unchanged': True}))
+        print(json.dumps({'passed': True, 'report': str(output), 'physical_injections': 0}))
+    finally:
+        for child in children:
+            if child.poll() is None:
+                child.terminate()
+                child.wait(timeout=10)
+        for handle in handles:
+            handle.close()
+
+
+if __name__ == '__main__':
+    main()
