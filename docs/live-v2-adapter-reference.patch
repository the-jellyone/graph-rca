+"""Early dispatch keeps live agents independent of legacy GraphRAG imports."""
+from pathlib import Path
+import sys
+
+
+def dispatch(command):
+    if '--agent-demo' not in sys.argv:
+        return
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
+    from rca_live.bootstrap import activate
+    activate()
+    from rca_live.cli import main
+    arguments = [value for value in sys.argv[1:] if value != '--agent-demo']
+    # Output is a top-level CLI option. Accept it anywhere in the legacy wrappers.
+    prefix = []
+    if '--output' in arguments:
+        index = arguments.index('--output')
+        prefix = arguments[index:index+2]
+        del arguments[index:index+2]
+    try:
+        main(prefix + [command] + arguments)
+    except (FileExistsError, RuntimeError, ValueError) as exc:
+        print('Cannot start demo: ' + str(exc), file=sys.stderr, flush=True)
+        raise SystemExit(1) from None
+    raise SystemExit(0)
