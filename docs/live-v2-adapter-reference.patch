+
+
+class GraphEvidenceBackend:
+    def __init__(self, rag, specs, registry, encoder):
+        self.rag,self.specs,self.registry,self.encoder = rag,{s.action_id:s for s in specs},registry,encoder
+    def capabilities(self, topology):
+        return {r:tuple(row['capabilities']) for r,row in self.registry.items()}
+    def begin(self, incident):
+        if incident.incident_id != self.rag.context['incident_id'] or incident.topology_hash != self.rag.topology.hash:
+            raise RuntimeError('graph incident identity mismatch')
+        self.incident = incident
+    def execute(self, spec):
+        if self.specs.get(spec.action_id) != spec:
+            raise ValueError('unregistered graph evidence query')
+        rows = self.rag.graph.query("MATCH (e:LiveEvidence {incident_id:$incident,action_id:$action}) RETURN e.packet_json AS packet,e.packet_hash AS hash",
+            params={'incident':self.incident.incident_id,'action':spec.action_id})
+        if len(rows) != 1:
+            raise RuntimeError('missing or ambiguous incident graph evidence')
+        payload = json.loads(rows[0]['packet'])
+        if digest(payload) != rows[0]['hash']:
+            raise RuntimeError('graph evidence checksum changed')
+        if self.rag.context.get('collection_protocol') in ('rolling_early_r1','rolling_early_r2','rolling_early_r3'):
+            from .short_packets import ShortPacket
+            packet = ShortPacket.from_dict(payload)
+        else:
+            packet = ToolResultV2.from_dict(payload)
+        packet.validate_context(spec,self.incident)
+        return packet
+    def close(self):
+        pass
+
+
+class GraphGuidedPolicy:
+    """Public graph alerts narrow initial probe choices. The frozen policy ranks them."""
+    def __init__(self, policy, context, specs):
+        self.policy,self.context,self.specs = policy,context,tuple(specs)
+        priorities = {'service_crash':'status','cpu_exhaustion':'cpu','memory_pressure':'memory',
+                      'slow_checkout':'latency','checkout_failures':'request_errors'}
+        self.candidates = []
+        for row in context['anomalies']:
+            for kind in (row.get('anomaly_type') or '').split(','):
+                family = priorities.get(kind)
+                if family:
+                    action = f"{family}/{row['name']}/v2"
+                    if action in {s.action_id for s in specs}:
+                        self.candidates.append(action)
+        # Confirm stopped resources before nonspecific downstream latency alerts.
+        self.candidates.sort(key=lambda action: (not action.startswith('status/'), action))
+    def choose(self, observation):
+        seen = {a for a,_ in observation['history']}
+        pending = [a for a in self.candidates if a not in seen and a in observation['mask']]
+        if any(a.startswith('status/') for a in pending):
+            pending = [a for a in pending if a.startswith('status/')]
+        elif self.context.get('collection_protocol') in ('rolling_early_r2','rolling_early_r3') and any(a.startswith(('cpu/','memory/')) for a in pending):
+            pending = [a for a in pending if a.startswith(('cpu/','memory/'))]
+        narrowed = {**observation,'graph_context':self.context,
+                    'mask':tuple(pending) if pending else observation['mask']}
+        action = self.policy.choose(narrowed)
+        if action not in narrowed['mask']:
+            # DP always includes terminal utilities internally. The graph obligation
+            # requires confirming a visible anomaly before accepting its terminal choice.
+            values = getattr(self.policy,'stats',{}).get('values',{})
+            action = max(pending,key=lambda a:values.get(a,float('-inf'))) if pending else action
+        self.stats = {**getattr(self.policy,'stats',{}),'graph_guided':True,'graph_candidates':pending}
+        return action
