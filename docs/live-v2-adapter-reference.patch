+def session_fixture(agents):
+    session=ProgressiveSession.__new__(ProgressiveSession)
+    agents.model=SimpleNamespace(hash='a'*64,diagnosis=lambda history:
+        {'resource/payment':.99,'NO_FAULT':.01} if any(a=='cpu/payment/v2' for a,_ in history) else {'resource/payment':.5,'NO_FAULT':.5})
+    session.agents,session.identifier,session.emit=agents,'early',lambda *args:None
+    session.name,session.identity='voi','a'*64
+    session.policy=SimpleNamespace(choose=lambda obs:obs['mask'][0],stats={})
+    session.ledger,session.history,session.trace=VersionedLedger(),(),[]
+    session.finished=False
+    session.last_context=None
+    return session
