+        assert receipt['resolved']
+    assert driver.calls == [('stop','orders'),('start','orders')]
+    assert not (controller.shared/'blocked-lab.json').exists()
+    receipts = list((tmp_path/'incidents').glob('*/receipt.json'))
+    assert json.loads(receipts[0].read_text())['status'] == ('FAILED' if fails else 'COMPLETE')
