+"""Frozen agents receive only paid evidence from a fresh live window."""
+import json
+from pathlib import Path
+from time import perf_counter
+from rca_investigation.backends.evidence_v2 import RawEvidenceBackend
+from rca_investigation.catalogue import build_catalogue, catalogue_hash
+from rca_investigation.comparison import load_frozen, policy_from_definition, policy_identity
+from rca_investigation.config import load_config
+from rca_investigation.contracts import digest
+from rca_investigation.contracts_v2 import IncidentPublicV2
+from rca_investigation.encoding import Encoder
+from rca_investigation.environment import InvestigationEnv
+from rca_investigation.experiment import load_model
+from rca_investigation.topology import sockshop_topology
+
+POLICIES = ('voi', 'dp', 'expected-sarsa', 'two-step-sarsa')
+
+
+class PaidWindowBackend(RawEvidenceBackend):
+    def capabilities(self, topology):
+        return {resource: tuple(row['capabilities']) for resource, row in self.registry.items()}
+
+
+class Agents:
+    def __init__(self, artifacts):
+        artifacts = Path(artifacts).resolve()
+        self.topology = sockshop_topology()
+        self.config = load_config('configs/investigation_v2c_memory_separation_r1.yaml', self.topology)
+        self.specs = build_catalogue(self.config, self.topology)
+        self.encoder = Encoder.load(self.config.values['paths']['encoder'])
+        saved = artifacts / 'runs/adaptive_v2c_memory_separation_r1'
+        self.model = load_model(saved / 'model.json', self.config, self.specs)
+        self.frozen = load_frozen(saved / 'final.json', artifacts / self.config.values['paths']['dataset'], self.config, self.model)
+        if not self.frozen.get('diagnostic_gate_passed'):
+            raise ValueError('frozen diagnostic gate did not pass')
+        self.identity = {'model_hash': self.model.hash, 'encoder_hash': self.encoder.hash,
+                         'config_hash': self.config.hash, 'selection_hash': self.frozen['hash'],
+                         'runtime_hash': self.frozen['runtime_hash'],
+                         'live_adapter_hash': digest({str(p.relative_to(Path(__file__).parent)): p.read_text(encoding='utf-8') for p in sorted(Path(__file__).parent.rglob('*.py'))})}
+
+    def investigate(self, incident_id, window, raw, registry, policy='voi', seed=11, hybrid=False, emit=lambda *a: None, mode='fresh_live_window', graph=None):
+        if policy not in POLICIES or seed not in (11, 22, 33, 44, 55):
+            raise ValueError('undeclared policy or seed')
+        key = policy if policy in ('voi', 'dp') else f"{policy}-{seed}-{'hybrid' if hybrid else 'tabular'}"
+        definition = self.frozen['definitions'][key]
+        chooser = policy_from_definition(definition, self.model, self.specs, self.config)
+        identity = policy_identity(definition, self.model, self.config)
+        topology = graph.topology if graph else self.topology
+        if graph:
+            from .graph import GraphGuidedPolicy
+            chooser = GraphGuidedPolicy(chooser, graph.context, self.specs)
+            identity = digest({'frozen_policy':identity,'graph_context_hash':digest(graph.context),'adapter':'graph_guided_live_r1'})
+        objective = self.config.values['objective']
+        incident = IncidentPublicV2(incident_id, self.topology.hash, catalogue_hash(self.specs),
+            'front-end', 'manual_frontend', window['window_start'], window['window_end'],
+            self.config.values['episode']['budget'], self.config.values['episode']['max_probes'],
+            objective['lambda_cost'], task_id=self.config.values['task_id'], encoding_hash=self.encoder.hash,
+            objective_hash=digest(objective))
+        env = InvestigationEnv(topology, self.specs, self.model,
+            graph.backend(self.specs,registry,self.encoder) if graph else PaidWindowBackend(self.specs, raw, registry, self.topology, self.encoder),
+            defer_utility=objective['defer'], correct_utility=objective['correct'], incorrect_utility=objective['incorrect'])
+        trace = []
+        env.reset(incident)
+        try:
+            while not env.terminated:
+                started = perf_counter()
+                action = chooser.choose(env.observation())
+                latency = (perf_counter() - started) * 1000
+                _, reward, _ = env.step(action, policy_hash=identity)
+                row = {'action': action, 'decision_latency_ms': latency, 'credits': env.ledger.credits,
+                       'reward': reward, 'terminal': env.terminated}
+                if action not in ('STOP', 'DEFER'):
+                    packet = env.ledger.packets[-1]
+                    row.update(response=packet.response_code, availability=packet.availability,
+                               evidence=json.loads(packet.evidence_json))
+                trace.append(row)
+                emit('probe', row)
+            result = {'incident_id': incident_id, 'policy': key, 'decision': env.decision.to_dict(),
+                      'trace': trace, 'packets': [p.to_dict() for p in env.ledger.packets],
+                      'probes': env.probes, 'credits': env.ledger.credits, 'probe_return': env.probe_return,
+                      'probabilities': env.model.diagnosis(env.history), 'identity': self.identity,
+                      'mode': mode, 'trained_during_demo': False}
+            if graph:
+                result.update(graph_context=graph.context, graph_guided=True,benchmark_equivalent=False)
+            emit('diagnosis', result)
+            return result
+        finally:
+            env.close()
