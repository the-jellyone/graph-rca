+from collections import deque
+from datetime import datetime,timedelta,timezone
+from threading import Lock,Event
+from types import SimpleNamespace
+import json
+import pytest
+from rca_live.streaming import ShortIncident,RollingCollector,PrefixBackend,incident_for,prefix_packets,PROTOCOL_HASH
+from rca_live.progressive import ProgressiveSession,VersionedLedger
+from rca_investigation.catalogue import build_catalogue
+from rca_investigation.config import load_config
+from rca_investigation.contracts import digest
+from rca_investigation.encoding import Encoder
+from rca_investigation.ledger import EvidenceLedger
+from rca_investigation.topology import sockshop_topology
+
+
+START=datetime(2026,10,15,tzinfo=timezone.utc)
+def stamp(seconds):
+    return (START+timedelta(seconds=seconds)).isoformat()
+
+
+@pytest.fixture
+def agents():
+    topology=sockshop_topology()
+    config=load_config('configs/investigation_v2c_memory_separation_r1.yaml',topology)
+    return SimpleNamespace(topology=topology,config=config,specs=build_catalogue(config,topology),
+        encoder=Encoder.load(config.values['paths']['encoder']),identity={})
+
+
+def registry():
+    return {r:{'container_id':'a'*64,'cpu_quota_cores':2.,'memory_limit_bytes':536870912,
+                'capabilities':['cpu','memory','status','logs','request_errors','latency']}
+            for r in ('front-end','orders','payment','carts','carts-db','catalogue','catalogue-db')}
+
+
+def raw(seconds,states=('exited','exited'),memory_fraction=.85,cpu=200):
+    resources=registry()
+    statistics=[]
+    for resource in ('payment','carts'):
+        for elapsed in range(0,int(seconds)+1,2):
+            statistics.append({'resource_id':resource,'container_id':'a'*64,'sample_time':stamp(elapsed),
+                'availability':'OK','units':'docker_cpu_percent','cpu_percent':cpu,'quota_cores':2.,
+                'memory_bytes':int(536870912*memory_fraction),'memory_limit_bytes':536870912,
+                'memory_source':'docker_cli_stats_linux_v2'})
+    return {'stats':statistics,'requests':[],'workload_errors':[],'logs':{},'collected_at':stamp(seconds),
+        'status':{r:{'state':'exited' if r=='orders' else 'running','container_id':'a'*64,'sample_time':stamp(seconds-1)} for r in resources},
+        'status_observations':[{'sample_time':stamp(seconds-2+i),'states':{r:states[i] if r=='orders' else 'running' for r in resources}} for i in range(2)]}
+
+
+def packet(agents,seconds,action,**kwargs):
+    incident=incident_for(agents,'early',{'window_start':stamp(0),'window_end':stamp(seconds)})
+    backend=PrefixBackend(agents.specs,raw(seconds,**kwargs),registry(),agents.topology,agents.encoder)
+    backend.begin(incident)
+    return backend.execute(next(s for s in agents.specs if s.action_id==action))
+
+
+def test_short_contract_uses_real_window_without_touching_frozen_contract(agents):
+    incident=incident_for(agents,'early',{'window_start':stamp(0),'window_end':stamp(5)})
+    assert (datetime.fromisoformat(incident.window_end)-datetime.fromisoformat(incident.window_start)).total_seconds()==5
+    from rca_investigation.contracts_v2 import IncidentPublicV2
+    with pytest.raises(ValueError,match='120'):
+        IncidentPublicV2(**incident.to_dict())
+
+
+def test_stop_requires_two_fresh_matching_observations(agents):
+    assert packet(agents,5,'status/orders/v2').response_code=='STOPPED'
+    assert packet(agents,5,'status/orders/v2',states=('running','exited')).availability=='NO_DATA'
+
+
+def test_cpu_waits_for_minimum_window(agents):
+    assert packet(agents,5,'cpu/payment/v2').availability=='NO_DATA'
+    assert packet(agents,10,'cpu/payment/v2').response_code=='HIGH'
+
+
+def test_short_packet_never_inflates_count_to_satisfy_benchmark(agents):
+    value=packet(agents,10,'cpu/payment/v2')
+    assert json.loads(value.evidence_json)['sample_count']==6
+    from rca_investigation.contracts_v2 import ToolResultV2
+    from rca_live.short_packets import ShortPacket
+    assert ShortPacket.from_dict(value.to_dict())==value
+    with pytest.raises(ValueError,match='coverage'):
+        ToolResultV2.from_dict(value.to_dict())
+
+
+def test_retained_memory_can_be_early_but_normal_growth_needs_longer(agents):
+    assert packet(agents,10,'memory/carts/v2').availability=='NO_DATA'
+    assert packet(agents,15,'memory/carts/v2').response_code=='PRESSURE'
+    assert packet(agents,20,'memory/carts/v2',memory_fraction=.5).availability=='NO_DATA'
+    assert packet(agents,90,'memory/carts/v2',memory_fraction=.5).response_code=='NORMAL'
+
+
+def test_request_metrics_do_not_invent_twenty_samples(agents):
+    assert packet(agents,15,'latency/front-end/v2').availability=='NO_DATA'
+    assert packet(agents,15,'request_errors/front-end/v2').availability=='NO_DATA'
+
+
+def test_rolling_snapshot_excludes_pre_alert_and_cross_boundary_requests():
+    collector=RollingCollector.__new__(RollingCollector)
+    collector.failure=None
+    collector.guard=Lock()
+    collector.driver=SimpleNamespace(ids={'orders':'a'*64})
+    collector.states=deque([{'sample_time':stamp(-2),'states':{'orders':'running'}},
+                            {'sample_time':stamp(2),'states':{'orders':'exited'}}])
+    collector.samples=deque([{'sample_time':stamp(-1)},{'sample_time':stamp(1)},
+                             {'sample_time':stamp(2),'observation_started_at':stamp(-1)}])
+    collector.errors=deque()
+    collector.requests=deque([{'sample_time':stamp(1),'request_started_at':stamp(-1),'tag':'crossed'},
+                              {'sample_time':stamp(3),'request_started_at':stamp(1),'tag':'fresh'}])
+    window,value=collector.snapshot(stamp(0),stamp(5))
+    assert len(value['stats'])==1
+    assert [r['tag'] for r in value['requests']]==['fresh']
+    assert value['status']['orders']['state']=='exited'
+    assert window['window_start']==stamp(0)
