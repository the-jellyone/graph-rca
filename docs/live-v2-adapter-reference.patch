+import json
+from types import SimpleNamespace
+from uuid import uuid4
+import pytest
+from rca_live.rolling_controller import RollingController
+
+
+@pytest.mark.parametrize('policy_fails',[False,True])
+def test_early_control_repairs_or_cleans_up_without_fixed_window(tmp_path,monkeypatch,policy_fails):
+    import rca_live.rolling_controller as module
+    calls=[]
+    controller=RollingController.__new__(RollingController)
+    controller.output,controller.shared=tmp_path,tmp_path/'lab'
+    controller.shared.mkdir()
+    controller.agents=SimpleNamespace(identity={},topology=SimpleNamespace(calls=()))
+    controller.registry={}
+    controller.driver=SimpleNamespace(ids={'orders':'a'*64},helper_leases={},
+        inject_stop=lambda r:calls.append('inject') or {},
+        state=lambda r:{'state':'exited'},recover=lambda r:calls.append('repair') or {})
+    baseline={'stats':[]}
+    controller.collector=SimpleNamespace(baseline=lambda:(True,{},baseline),snapshot=lambda *args:({},{}))
+    controller._stop_collector=lambda:calls.append('collector_stopped')
+    controller.verify_health=lambda *args:{'confirmed':True,'consecutive_checkouts':[{}]*5}
+    controller.emit=lambda *args:None
+    monkeypatch.setattr(module,'CheckoutWorkload',lambda:SimpleNamespace(close=lambda:None))
+    monkeypatch.setattr(module,'prefix_packets',lambda *args:(None,[],{'status/orders/v2'}))
+    # The controller reads window_end for its deadline. Provide true current time.
+    controller.collector.snapshot=lambda since,finish:({'window_start':since,'window_end':finish},{})
+    rag=SimpleNamespace(topology=SimpleNamespace(calls=()),publish=lambda *args,**kwargs:{'anomalies':[{'name':'orders'}]},
+                        graph=SimpleNamespace(query=lambda *args,**kwargs:[]))
+    def advance(*args,**kwargs):
+        if policy_fails:
+            raise RuntimeError('policy failed')
+        return {'decision':{'prediction':'resource/orders','confidence':.99},'observation_seconds':2.,
+            'packets':[{'action_id':'status/orders/v2','response_code':'STOPPED','availability':'OK'}]}
+    monkeypatch.setattr(module,'ProgressiveSession',lambda *args:SimpleNamespace(advance=advance,history=(),ledger=SimpleNamespace(credits=0,packets=[])))
+    item={'id':str(uuid4()),'command':'run','case':'orders'}
+    if policy_fails:
+        with pytest.raises(RuntimeError,match='policy failed'):
+            controller._run_owned(item,rag)
+    else:
+        result=controller._run_owned(item,rag)
+        assert result['resolved'] and result['diagnosis_seconds']<2
+    assert calls[:2]==['inject','repair']
+    assert 'collector_stopped' in calls
+    assert not (controller.shared/'blocked-lab.json').exists()
+    receipt=json.loads(next((tmp_path/'incidents').glob('*/receipt.json')).read_text())
+    assert receipt['status']==('FAILED' if policy_fails else 'COMPLETE')
