index 0000000..95b8015
--- /dev/null
+++ b/team-graph-rca/src/rca_live/progressive.py
@@ -0,0 +1,152 @@
+"""One paid ledger across successive short-window graph updates."""
+import json
+from datetime import timedelta
+from time import perf_counter
+from rca_investigation.catalogue import catalogue_hash
+from rca_investigation.comparison import policy_from_definition, policy_identity
+from rca_investigation.contracts import Decision, digest, timestamp
+from .graph import GraphGuidedPolicy
+from .streaming import PROTOCOL, PROTOCOL_HASH
+
+
+class VersionedLedger:
+    """Every refresh is billed; the model sees only the latest symbol per tool."""
+    def __init__(self):
+        self.packets=[]
+        self.latest={}
+        self.credits=0
+    @property
+    def acquired_actions(self):
+        return tuple(self.latest)
+    @property
+    def latest_packets(self):
+        return tuple(self.latest.values())
+    @property
+    def evidence_ids(self):
+        return tuple(p.evidence_id for p in self.latest_packets)
+    def acquire(self,spec,packet,incident):
+        packet.validate_context(spec,incident)
+        if any(p.evidence_id==packet.evidence_id for p in self.packets):
+            raise ValueError('identical evidence cannot be billed twice')
+        if self.credits+spec.credits>10 or len(self.packets)>=5:
+            raise ValueError('live evidence budget exceeded')
+        self.packets.append(packet)
+        self.latest[spec.action_id]=packet
+        self.credits+=spec.credits
+
+
+def supported(prediction, packets):
+    if prediction in ('DEFER','NO_FAULT'):
+        return False
+    tests = {'resource/orders':('status/orders/v2',{'STOPPED'}),
+             'resource/catalogue-db':('status/catalogue-db/v2',{'STOPPED'}),
+             'resource/payment':('cpu/payment/v2',{'HIGH'}),
+             'resource/carts':('memory/carts/v2',{'PRESSURE','PRESSURE_AND_GROWTH'}),
+             'edge/orders/payment':('latency/front-end/v2',{'SLOW'})}
+    action,codes = tests.get(prediction,('',set()))
+    return any(p.action_id==action and p.availability=='OK' and p.response_code in codes for p in packets)
+
+
+class ProgressiveSession:
+    def __init__(self,agents,identifier,policy='voi',seed=11,hybrid=False,emit=lambda *args:None):
+        self.agents,self.identifier,self.emit = agents,identifier,emit
+        self.name = policy if policy in ('voi','dp') else f"{policy}-{seed}-{'hybrid' if hybrid else 'tabular'}"
+        definition = agents.frozen['definitions'][self.name]
+        self.policy = policy_from_definition(definition,agents.model,agents.specs,agents.config)
+        self.identity = digest({'policy':policy_identity(definition,agents.model,agents.config),'live_protocol':PROTOCOL_HASH})
+        self.ledger,self.history,self.trace = VersionedLedger(),(),[]
+        self.finished = False
+        self.last_context = None
+
+    def eligible(self, incident, now, context):
+        probabilities = self.agents.model.diagnosis(self.history)
+        prediction = max(probabilities,key=probabilities.get)
+        packets = self.ledger.latest_packets
+        recent = all(0 <= (timestamp(now)-timestamp(p.window_end)).total_seconds() <=15 for p in packets)
+        elapsed = (timestamp(incident.window_end)-timestamp(incident.window_start)).total_seconds()
+        confident = probabilities[prediction]>=.90 and bool(packets) and recent
+        # Absence of alerts is not an early healthy verdict. Growth needs observation.
+        okay = supported(prediction,packets) or (prediction=='NO_FAULT' and elapsed>=90 and not context['anomalies'])
+        return confident and okay,prediction,probabilities
+
+    def advance(self,incident,graph,ready,now,deadline=False):
+        advance_started = perf_counter()
+        if self.finished:
+            raise RuntimeError('progressive session already finished')
+        self.last_context = graph.context
+        elapsed = (timestamp(incident.window_end)-timestamp(incident.window_start)).total_seconds()
+        # Monitor alerts are public. Do not burn the paid budget on blind status checks
+        # while CPU/request/memory evidence is still becoming ready.
+        if not graph.context['anomalies'] and not self.history and elapsed<90 and not deadline:
+            return None
+        backend = graph.backend(self.agents.specs,{},self.agents.encoder)
+        backend.begin(incident)
+        specs = self.agents.specs
+        try:
+            while True:
+                actual_now = (timestamp(now)+timedelta(seconds=perf_counter()-advance_started)).isoformat()
+                can_finish,prediction,probabilities = self.eligible(incident,actual_now,graph.context)
+                if can_finish:
+                    return self.finish(prediction,probabilities[prediction],'early_confident',incident)
+                refreshing = False
+                stale = [p for p in self.ledger.latest_packets if (timestamp(actual_now)-timestamp(p.window_end)).total_seconds()>15]
+                refresh = [p for p in stale if p.action_id in ready and len(self.ledger.packets)<5
+                           and self.ledger.credits+next(s.credits for s in specs if s.action_id==p.action_id)<=10]
+                if probabilities[prediction]>=.90 and supported(prediction,self.ledger.latest_packets) and stale:
+                    if not refresh:
+                        return self.finish('DEFER',0.,'cannot_refresh_within_budget',incident)
+                    action = min(refresh,key=lambda p:timestamp(p.window_end)).action_id
+                    latency = 0.
+                    refreshing = True
+                remaining = [s.action_id for s in specs if s.action_id in ready and s.action_id not in self.ledger.acquired_actions
+                             and self.ledger.credits+s.credits<=10 and len(self.ledger.packets)<5]
+                crash_resources = {row['name'] for row in graph.context['anomalies'] if 'service_crash' in (row.get('anomaly_type') or '')}
+                remaining = [action for action in remaining if not action.startswith('status/') or action.split('/')[1] in crash_resources]
+                if not remaining and not refreshing:
+                    exhausted = len(self.ledger.packets)>=5 or self.ledger.credits>=10
+                    return self.finish('DEFER',0.,'deadline_or_budget',incident) if deadline or exhausted else None
+                objective = self.agents.config.values['objective']
+                observation = {'topology':graph.topology.to_dict(),'topology_hash':graph.topology.hash,
+                    'catalogue_hash':catalogue_hash(specs),'entry_resource':'front-end','entry_protocol':'manual_frontend',
+                    'history':self.history,'diagnoses':probabilities,'prices':{s.action_id:s.credits for s in specs},
+                    'remaining_credits':10-self.ledger.credits,'remaining_probes':5-len(self.ledger.packets),'lambda_cost':objective['lambda_cost'],
+                    'mask':tuple(remaining)+('STOP','DEFER'),'objective':objective,'schema_version':2,
+                    'task_id':self.agents.config.values['task_id'],'encoding_hash':self.agents.encoder.hash,
+                    'objective_hash':digest(objective),'alert_context':'{}'}
+                if not refreshing:
+                    chooser = GraphGuidedPolicy(self.policy,graph.context,specs)
+                    started = perf_counter()
+                    action = chooser.choose(observation)
+                    latency = (perf_counter()-started)*1000
+                if action in ('STOP','DEFER'):
+                    # A premature terminal proposal waits for another update. It does
+                    # not reset costs or lower the confidence/support conditions.
+                    if deadline:
+                        return self.finish('DEFER',0.,'insufficient_support',incident)
+                    return None
+                packet = backend.execute(next(s for s in specs if s.action_id==action))
+                if packet.availability!='OK':
+                    raise RuntimeError('ready graph evidence became unavailable')
+                self.ledger.acquire(next(s for s in specs if s.action_id==action),packet,incident)
+                self.history = tuple((a,symbol) for a,symbol in self.history if a!=action)+((action,packet.symbol),)
+                row = {'action':action,'response':packet.response_code,'availability':packet.availability,
+                       'evidence':json.loads(packet.evidence_json),'credits':self.ledger.credits,
+                       'decision_latency_ms':latency,'elapsed_incident_seconds':elapsed,'terminal':False,'refresh':refreshing}
+                self.trace.append(row)
+                self.emit('probe',row)
+        finally:
+            backend.close()
+
+    def finish(self,prediction,confidence,reason,incident):
+        self.finished = True
+        result = {'incident_id':self.identifier,'policy':self.name,'mode':PROTOCOL['name'],
+                  'decision':Decision(prediction,confidence,self.ledger.evidence_ids,self.identity,self.agents.model.hash,reason).to_dict(),
+                  'packets':[p.to_dict() for p in self.ledger.latest_packets],
+                  'acquisition_packets':[p.to_dict() for p in self.ledger.packets],'trace':self.trace,'credits':self.ledger.credits,
+                  'probes':len(self.ledger.packets),'probe_return':-self.agents.config.values['objective']['lambda_cost']*self.ledger.credits,
+                  'probabilities':self.agents.model.diagnosis(self.history),'identity':self.agents.identity,
+                  'graph_context':self.last_context,'graph_guided':True,'benchmark_equivalent':False,
+                  'trained_during_demo':False,'protocol_hash':PROTOCOL_HASH,
+                  'observation_seconds':(timestamp(incident.window_end)-timestamp(incident.window_start)).total_seconds()}
+        self.emit('diagnosis',result)
+        return result
diff --git a/team-graph-rca/src/rca_live/recovery.py b/team-graph-rca/src/rca_live/recovery.py
new file mode 100644
index 0000000..f4abaa7
--- /dev/null
+++ b/team-graph-rca/src/rca_live/recovery.py
@@ -0,0 +1,87 @@
+"""Recover this demo's persisted ownership after an interrupted controller."""
+import csv
+import io
+import json
+import os
+from pathlib import Path
+import subprocess
+from .bus import emit
+from .controller import Controller
+from .repair import OwnedFault
+from rca_investigation.workload_v2 import CheckoutWorkload
+
+
+def alive(pid):
+    if type(pid) is not int or pid < 1:
+        raise ValueError('invalid persisted owner PID')
+    if os.name == 'nt':
+        value = subprocess.run(['tasklist', '/FI', f'PID eq {pid}', '/FO', 'CSV', '/NH'],
+                               capture_output=True, text=True, timeout=10, check=True)
+        return any(len(row) > 1 and row[1] == str(pid) for row in csv.reader(io.StringIO(value.stdout)))
+    try:
+        os.kill(pid, 0)
+        return True
+    except ProcessLookupError:
+        return False
+
+
+def recover(artifacts, output):
+    controller = Controller(artifacts, output)
+    server = Path(output) / 'server.lock'
+    if server.exists() and alive(json.loads(server.read_text())['pid']):
+        raise RuntimeError('demo controller is still running; use its safe shutdown')
+    marker = controller.shared / 'blocked-lab.json'
+    lease = controller.shared / 'capture.lock'
+    if lease.exists() and alive(json.loads(lease.read_text())['pid']):
+        raise RuntimeError('another physical controller still owns the lab')
+    if marker.exists():
+        saved = json.loads(marker.read_text())
+        if not saved.get('live_demo'):
+            raise RuntimeError('recovery marker belongs to another controller')
+        journal = Path(saved['journal']).resolve()
+        if not journal.is_relative_to(Path(output).resolve() / 'incidents'):
+            raise RuntimeError('recovery journal is outside this demo')
+        intent = json.loads(journal.read_text())
+        if saved['owner'] != intent['owner'] or alive(intent['pid']):
+            raise RuntimeError('persisted ownership mismatch or owner still alive')
+        controller.identities()
+        fault = OwnedFault(controller.driver, controller.registry, journal, marker)
+        fault.intent = intent
+        workload = CheckoutWorkload()
+        try:
+            fault.restore()
+            health = controller.verify_health(workload, fault)
+            fault.confirmed(health)
+            emit(output, 'recovery', {'incident_id': intent['owner'], 'health': health})
+        finally:
+            workload.close()
+        if lease.exists():
+            if json.loads(lease.read_text())['pid'] != intent['pid']:
+                raise RuntimeError('lease owner changed; refusing removal')
+            lease.unlink()
+    elif lease.exists():
+        # A crash in the baseline leaves a lease but no injection journal.
+        # The dead server PID and an initial receipt must both match that lease.
+        pid = json.loads(lease.read_text())['pid']
+        if not server.exists() or json.loads(server.read_text())['pid'] != pid:
+            raise RuntimeError('shared lease has no matching live demo owner')
+        matches = [p for p in (Path(output)/'incidents').glob('*/receipt.json')
+                   if json.loads(p.read_text()).get('pid') == pid]
+        if not matches:
+            raise RuntimeError('shared lease has no live demo receipt')
+        controller.identities()
+        fault = OwnedFault(controller.driver, controller.registry, Path(output)/'unused.json', marker)
+        workload = CheckoutWorkload()
+        try:
+            health = controller.verify_health(workload, fault)
+            if not health['confirmed']:
+                raise RuntimeError('baseline recovery health failed; keeping the shared lease')
+        finally:
+            workload.close()
+        if json.loads(lease.read_text())['pid'] != pid:
+            raise RuntimeError('shared lease changed during health checks')
+        lease.unlink()
+        emit(output, 'recovery', {'stage':'baseline_crash_recovered', 'health':health})
+    if server.exists():
+        server.unlink()
+    return {'recovered': True}
diff --git a/team-graph-rca/src/rca_live/repair.py b/team-graph-rca/src/rca_live/repair.py
new file mode 100644
index 0000000..01a5eaf
--- /dev/null
+++ b/team-graph-rca/src/rca_live/repair.py
@@ -0,0 +1,142 @@
+"""Bounded, owned demo recovery. No generated commands or broad restarts."""
+import json
+import os
+from pathlib import Path
+from rca_investigation.dataset import atomic_json
+
+CASES = {'healthy': ('NO_FAULT', None, None),
+         'catalogue-db': ('resource/catalogue-db', 'stop', 'catalogue-db'),
+         'orders': ('resource/orders', 'stop', 'orders'),
+         'payment-cpu': ('resource/payment', 'cpu', 'payment'),
+         'payment-delay': ('edge/orders/payment', 'delay', 'payment-path-proxy'),
+         'carts-memory': ('resource/carts', 'memory', 'carts')}
+
+
+def repair_allowed(result, intent):
+    """The injector's case/label never enters policy observations."""
+    decision = result['decision']
+    if not intent or decision['prediction'] in ('DEFER', 'NO_FAULT'):
+        return False
+    if decision['confidence'] < .80 or decision['prediction'] != intent['cause']:
+        return False
+    # Paid evidence must support the mechanism, rather than confidence alone.
+    family = {'stop': 'status', 'cpu': 'cpu', 'memory': 'memory', 'delay': 'latency'}[intent['kind']]
+    codes = {'stop': {'STOPPED'}, 'cpu': {'HIGH'}, 'memory': {'PRESSURE', 'PRESSURE_AND_GROWTH'}, 'delay': {'SLOW'}}[intent['kind']]
+    resource = 'front-end' if intent['kind'] == 'delay' else intent['resource']
+    return any(p['availability'] == 'OK' and p['action_id'] == f'{family}/{resource}/v2'
+               and p['response_code'] in codes for p in result['packets'])
+
+
+class OwnedFault:
+    def __init__(self, driver, registry, journal, shared_marker):
+        self.driver, self.registry = driver, registry
+        self.journal, self.marker = Path(journal), Path(shared_marker)
+        self.intent = None
+
+    def save(self):
+        atomic_json(self.journal, self.intent)
+        atomic_json(self.marker, {'live_demo': True, 'journal': str(self.journal.resolve()),
+                                 'owner': self.intent['owner'], 'recovery_required': True})
+
+    def inject(self, case, owner, baseline_memory=None):
+        cause, kind, resource = CASES[case]
+        if kind is None:
+            return None
+        if self.marker.exists():
+            raise RuntimeError('prior unconfirmed lab recovery')
+        allocation = 0
+        if kind == 'memory':
+            limit = self.registry[resource]['memory_limit_bytes']
+            if type(baseline_memory) is not int:
+                raise RuntimeError('healthy measured memory baseline required')
+            allocation = min(int(limit * .83) - baseline_memory, int(limit * .5))
+            if allocation < 64 * 1024**2:
+                raise RuntimeError('healthy memory baseline leaves no allocation margin')
+        self.intent = {'owner': owner, 'pid': os.getpid(), 'cause': cause, 'kind': kind, 'resource': resource,
+                       'container_id': self.driver.ids.get(resource), 'phase': 'intent'}
+        if kind == 'delay':
+            before = self.driver.proxy_control()
+            if before['delay_ms'] != 0:
+                raise RuntimeError('proxy already has a foreign delay')
+            # Record exact proxy identity before its control command.
+            self.intent['container_id'] = before['receipt']['argv'][1]
+        if kind in ('cpu', 'memory'):
+            running, _ = self.driver.command(['exec', self.driver.ids[resource], 'sh', '-c',
+                'if [ -f /tmp/rca-helper.pid ]; then cat /tmp/rca-helper.pid; fi'])
+            if running.strip():
+                raise RuntimeError('an existing helper owns this container')
+        self.save()
+        if kind == 'stop':
+            receipt = self.driver.inject_stop(resource)
+        elif kind == 'delay':
+            receipt = self.driver.proxy_control(800)
+        else:
+            if kind == 'memory':
+                self.intent['baseline_memory_bytes'] = baseline_memory
+            else:
+                allocation = 0
+            # Persist the helper lease before launch, including partial launch failures.
+            from uuid import uuid4
+            lease = str(uuid4())
+            self.intent['lease'] = lease
+            self.save()
+            # This adapter supplies the predetermined lease without altering the frozen driver.
+            receipt = self._helper(resource, kind, lease, allocation)
+        self.intent.update(phase='injected', receipt=receipt)
+        self.save()
+        return dict(self.intent)
+
+    def _helper(self, resource, mode, lease, allocation):
+        import hashlib
+        binary = Path(self.driver.root) / 'lab/adaptive-helper/rca-helper-lease'
+        pin = json.loads((Path(self.driver.root) / 'configs/lab_adaptive_v2_lease.json').read_text())
+        if hashlib.sha256(binary.read_bytes()).hexdigest() != pin['helper_sha256']:
+            raise ValueError('helper binary changed')
+        if self.driver.state(resource)['state'] != 'running':
+            raise RuntimeError('helper target stopped')
+        self.driver.helper_leases[resource] = lease
+        self.driver.command(['cp', str(binary), self.driver.ids[resource] + ':/tmp/rca-helper'])
+        _, receipt = self.driver.command(['exec', '-d', self.driver.ids[resource], '/tmp/rca-helper',
+            '-mode', mode, '-seconds', '240', '-workers', '8', '-bytes', str(allocation), '-lease', lease])
+        return {**receipt, 'helper_hash': pin['helper_sha256'], 'lease': lease}
+
+    def restore(self):
+        if self.intent is None or self.intent['phase'] in ('restored', 'confirmed'):
+            return None
+        item = self.intent
+        resource, kind = item['resource'], item['kind']
+        if kind == 'delay':
+            before = self.driver.proxy_control()
+            if before['receipt']['argv'][1] != item['container_id']:
+                raise RuntimeError('proxy identity changed; refusing recovery')
+            if before['delay_ms'] not in (0, 800):
+                raise RuntimeError('foreign proxy setting; refusing recovery')
+            receipt = self.driver.proxy_control(0) if before['delay_ms'] else {'already_restored': True}
+        else:
+            if self.driver.ids.get(resource) != item['container_id']:
+                raise RuntimeError('owned container identity changed')
+            if kind == 'stop':
+                receipt = self.driver.recover(resource) if self.driver.state(resource)['state'] in ('exited', 'dead') else {'already_restored': True}
+            else:
+                if 'lease' in item:
+                    running, _ = self.driver.command(['exec', self.driver.ids[resource], 'sh', '-c',
+                        'if [ -f /tmp/rca-helper.pid ]; then cat /tmp/rca-helper.pid; fi'])
+                    self.driver.helper_leases[resource] = item['lease']
+                    receipt = self.driver.stop_helper(resource) if running.strip() else {'already_restored': True}
+                else:
+                    receipt = {'skipped': 'helper launch had not been attempted'}
+        self.intent.update(phase='restored', recovery_command=receipt)
+        self.save()
+        return receipt
+
+    def confirmed(self, health):
+        if self.intent is None:
+            return
+        if not health['confirmed']:
+            raise RuntimeError('lab recovery has not passed')
+        self.intent.update(phase='confirmed', health=health)
+        atomic_json(self.journal, self.intent)
+        marker = json.loads(self.marker.read_text())
+        if marker.get('owner') != self.intent['owner']:
+            raise RuntimeError('another owner changed recovery marker')
+        self.marker.unlink()
diff --git a/team-graph-rca/src/rca_live/rolling_controller.py b/team-graph-rca/src/rca_live/rolling_controller.py
new file mode 100644
index 0000000..5063d28
--- /dev/null
+++ b/team-graph-rca/src/rca_live/rolling_controller.py
@@ -0,0 +1,211 @@
+"""Continuous collection with one progressive graph investigation per owned fault."""
+from contextlib import contextmanager
+from datetime import timedelta
+import json
+import os
+from pathlib import Path
+from time import monotonic,sleep
+from uuid import uuid4
+from rca_investigation.capture import capture_lease, RecoveryFailed
+from rca_investigation.contracts import timestamp
+from rca_investigation.dataset import atomic_json
+from rca_investigation.workload_v2 import CheckoutWorkload
+from .bus import pending,server_lock
+from .controller import Controller,foreign_collectors,validate_request
+from .progressive import ProgressiveSession
+from .repair import OwnedFault,repair_allowed
+from .streaming import RollingCollector,PROTOCOL,PROTOCOL_HASH,prefix_packets,utcnow
+
+
+class RollingController(Controller):
+    def _start_collector(self):
+        self.stream_workload = CheckoutWorkload()
+        self.collector = RollingCollector(self.driver,self.stream_workload,self.stats)
+        try:
+            self.collector.__enter__()
+        except BaseException:
+            self.stream_workload.close()
+            raise
+
+    def _stop_collector(self):
+        if getattr(self,'collector',None):
+            self.collector.__exit__(None,None,None)
+        if getattr(self,'stream_workload',None):
+            self.stream_workload.close()
+
+    def _wait_baseline(self):
+        self.emit('rolling',{'stage':'warming','message':'Building a rolling healthy baseline; twenty successful checkouts required.'})
+        deadline = monotonic()+90
+        while monotonic()<deadline:
+            good,window,raw = self.collector.baseline()
+            if good:
+                return window,raw
+            sleep(.5)
+        raise RuntimeError('rolling baseline did not reach twenty healthy checkouts; no injection was applied')
+
+    @contextmanager
+    def _owned_monitor(self):
+        if foreign_collectors():
+            raise RuntimeError('another physical controller owns the lab; rolling traffic must wait')
+        with capture_lease(self.shared),self.graph_factory() as rag:
+            legacy = self.artifacts/'runs/integration_v1/captures/sockshop_v1'
+            if any((legacy/name).exists() for name in ('capture.lock','blocked-lab.json')):
+                raise RecoveryFailed('legacy controller owns this lab')
+            self.identities()
+            if any(v!='running' for v in self.driver.states().values()) or self.driver.proxy_control()['delay_ms']!=0:
+                raise RuntimeError('healthy lab baseline required; existing faults are not demo-owned')
+            atomic_json(self.output/'rolling-protocol.json',{'protocol':PROTOCOL,'hash':PROTOCOL_HASH})
+            from rca_investigation.contracts import digest
+            source_root=Path(__file__).parent
+            source={str(p.relative_to(source_root)):p.read_text(encoding='utf-8') for p in sorted(source_root.rglob('*.py'))}
+            atomic_json(self.output/'runtime-source.json',{'files':source,'hash':digest(source),
+                'protocol_hash':PROTOCOL_HASH,'identity':self.agents.identity})
+            self._start_collector()
+            try:
+                self._wait_baseline()
+                yield rag
+            finally:
+                self._stop_collector()
+
+    def run(self,item):
+        validate_request(item)
+        with self._owned_monitor() as rag:
+            return self._run_owned(item,rag)
+
+    def _run_owned(self,item,rag):
+        validate_request(item)
+        owner = str(uuid4())
+        directory = self.output/'incidents'/owner
+        directory.mkdir(parents=True)
+        fault = OwnedFault(self.driver,self.registry,directory/'recovery.json',self.shared/'blocked-lab.json')
+        recovery_workload = CheckoutWorkload()
+        receipt = {'incident_id':owner,'request_id':item['id'],'case':item['case'],'status':'STARTED',
+                   'pid':os.getpid(),'identity':self.agents.identity,'mode':PROTOCOL['name'],
+                   'protocol_hash':PROTOCOL_HASH,'training_or_benchmark_record':False}
+        atomic_json(directory/'receipt.json',receipt)
+        result,repaired,health = None,False,None
+        started = None
+        try:
+            good,baseline_window,baseline = self.collector.baseline()
+            if not good:
+                baseline_window,baseline = self._wait_baseline()
+            atomic_json(directory/'baseline.json',{'window':baseline_window,'measurements':baseline})
+            samples = [r for r in baseline['stats'] if r['resource_id']=='carts' and r['availability']=='OK']
+            memory = samples[-1]['memory_bytes'] if samples else None
+            # This boundary precedes injection. Requests that began earlier are excluded.
+            since,started = utcnow(),monotonic()
+            receipt['alert_boundary'] = since
+            receipt['injection_requested_at'] = since
+            fault.inject(item['case'],owner,memory)
+            receipt['injection_command_seconds'] = monotonic()-started
+            session = ProgressiveSession(self.agents,owner,item.get('policy','voi'),item.get('seed',11),item.get('hybrid',False),self.emit)
+            self.emit('rolling',{'stage':'investigating','message':'Watching fresh post-alert evidence. Diagnosing as soon as support is sufficient.'})
+            updates = 0
+            previous_alerts = None
+            last_progress_report = -10.
+            while True:
+                finish = min(timestamp(utcnow()),timestamp(since)+timedelta(seconds=120)).isoformat()
+                window,raw = self.collector.snapshot(since,finish)
+                incident,packets,ready = prefix_packets(self.agents,owner,window,raw,self.registry)
+                context = rag.publish(owner,window,raw,self.registry,self.agents,packets=packets)
+                alerts = sorted(r['name'] for r in context['anomalies'])
+                if alerts!=previous_alerts:
+                    self.emit('graph',{'dependencies':len(rag.topology.calls),'anomalies':alerts,'stage':'retrieved','incident_id':owner})
+                    previous_alerts = alerts
+                updates += 1
+                deadline = (timestamp(window['window_end'])-timestamp(since)).total_seconds()>=120
+                result = session.advance(incident,rag,ready,utcnow(),deadline=deadline)
+                atomic_json(directory/'progress.json',{'updates':updates,'elapsed_seconds':monotonic()-started,
+                    'ready_actions':sorted(ready),'probes':len(session.ledger.packets),'credits':session.ledger.credits,
+                    'anomalies':[r['name'] for r in context['anomalies']]})
+                elapsed_progress = monotonic()-started
+                if updates==1 or result or elapsed_progress-last_progress_report>=10:
+                    self.emit('rolling',{'stage':'evidence','message':f"Post-alert evidence: {monotonic()-started:.1f} seconds; {len(ready)} tools ready; {len(session.ledger.packets)} probes purchased."})
+                    last_progress_report = elapsed_progress
+                if result:
+                    atomic_json(directory/'window.json',{'window':window,'measurements':raw})
+                    atomic_json(directory/'graph-context.json',context)
+                    atomic_json(directory/'diagnosis.json',result)
+                    receipt.update(diagnosis=result['decision'],diagnosis_seconds=monotonic()-started,
+                                   observation_seconds=result['observation_seconds'],updates=updates)
+                    break
+                sleep(.5)
+            if repair_allowed(result,fault.intent):
+                self.emit('repair',{'incident_id':owner,'stage':'owned_repair_started','cause':result['decision']['prediction']})
+                receipt['repair_started_seconds'] = monotonic()-started
+                command = fault.restore()
+                repaired = not command.get('already_restored',False)
+                receipt['repair_command_completed_seconds'] = monotonic()-started
+            elif fault.intent:
+                self.emit('repair',{'incident_id':owner,'stage':'withheld'})
+            else:
+                self.emit('repair',{'incident_id':owner,'stage':'no_injected_fault'})
+        except BaseException as exc:
+            receipt.update(status='FAILED',error=f'{type(exc).__name__}: {exc}',resolved=False)
+            self.emit('failure',{'incident_id':owner,'error':receipt['error']})
+            raise
+        finally:
+            try:
+                if fault.intent and fault.intent['phase'] not in ('restored','confirmed'):
+                    self.emit('cleanup',{'incident_id':owner,'stage':'restore_owned_injection'})
+                    fault.restore()
+                # Actuation happens before quiescing traffic. Recovery uses its own
+                # session after in-flight monitor requests finish, avoiding cart races.
+                self._stop_collector()
+                health = self.verify_health(recovery_workload,fault)
+                receipt['health'] = health
+                if not health['confirmed']:
+                    raise RecoveryFailed('rolling incident recovery did not pass')
+                fault.confirmed(health)
+                rag.graph.query("MATCH (n {lab_project:'rca-lab',live_incident_id:$incident}) SET n.anomaly_flag=false,n.anomaly_type=null,n.anomaly_since=null,n.status='healthy',n.live_recovery_confirmed=true",params={'incident':owner})
+                rag.graph.query("MATCH (a {lab_project:'rca-lab',live_incident_id:$incident})-[r:TRIGGERS]->() DELETE r",params={'incident':owner})
+                if receipt['status']!='FAILED':
+                    receipt.update(status='COMPLETE',agent_repair=repaired,resolved=bool(repaired),cleanup_confirmed=True,
+                        healthy_control_confirmed=bool(not fault.intent and result and result['decision']['prediction']=='NO_FAULT'))
+                if started is not None:
+                    receipt['verified_recovery_seconds'] = monotonic()-started
+            except BaseException as exc:
+                receipt.update(status='RECOVERY_FAILED',error=f'{type(exc).__name__}: {exc}',resolved=False)
+                raise
+            finally:
+                recovery_workload.close()
+                atomic_json(directory/'receipt.json',receipt)
+                self.emit('complete',receipt)
+        return receipt
+
+    def serve(self,once=False):
+        policy = {'policy':'voi','seed':11,'hybrid':False}
+        with server_lock(self.output),self._owned_monitor() as rag:
+            self.emit('ready',{'policy':policy,'identity':self.agents.identity,'output':str(self.output),'collection':PROTOCOL['name']})
+            last_update = 0
+            while True:
+                entries = list(pending(self.output))
+                entries.sort(key=lambda entry:entry[1].get('command')!='stop')
+                if entries:
+                    path,item = entries[0]
+                    destination = self.output/'processed'/path.name
+                    destination.parent.mkdir(exist_ok=True)
+                    path.rename(destination)
+                    validate_request(item)
+                    if item['command']=='stop':
+                        self.emit('stopped',{'request_id':item['id']})
+                        return
+                    if item['command']=='policy':
+                        policy = {key:item.get(key,policy[key]) for key in policy}
+                        self.emit('policy',policy)
+                    else:
+                        self._run_owned({**policy,**item},rag)
+                        if once:
+                            return
+                        self._start_collector()
+                        self._wait_baseline()
+                    if once:
+                        return
+                elif monotonic()-last_update>=5:
+                    end = timestamp(utcnow())
+                    since = max(timestamp(self.collector.started),end-timedelta(seconds=120)).isoformat()
+                    window,raw = self.collector.snapshot(since,end.isoformat())
+                    _,packets,_ = prefix_packets(self.agents,'rolling-monitor',window,raw,self.registry)
+                    rag.publish('rolling-monitor',window,raw,self.registry,self.agents,packets=packets)
+                    last_update = monotonic()
+                sleep(.25)
diff --git a/team-graph-rca/src/rca_live/short_packets.py b/team-graph-rca/src/rca_live/short_packets.py
new file mode 100644
index 0000000..a4ee70e
--- /dev/null
+++ b/team-graph-rca/src/rca_live/short_packets.py
@@ -0,0 +1,123 @@
+"""Live short-window packet validation; frozen benchmark packets are unchanged.
+
+V2 field checks are retained. Container sample support scales with the actual
+observation duration, in addition to the live CPU and memory readiness gates.
+No sample counts or timestamps are padded. Never write benchmark bundles with
+this live-only packet class.
+"""
+import json
+import math
+from rca_investigation.contracts import ToolResult, timestamp, integer, real, identifier, canonical
+from rca_investigation.contracts_v2 import ToolResultV2, sha256, object_json, UNITS
+
+
+class ShortPacket(ToolResultV2):
+    def __post_init__(self):
+        ToolResult.__post_init__(self)
+        if type(self.schema_version) is not int or self.schema_version != 2:
+            raise ValueError('unsupported packet schema')
+        if timestamp(self.collected_at) < timestamp(self.sample_time):
+            raise ValueError('collection precedes evidence')
+        sha256(self.encoding_hash)
+        if type(self.reason) is not str or len(self.reason.encode()) > 256:
+            raise ValueError('invalid bounded reason')
+        if self.availability == 'OK' and self.response_code == 'UNAVAILABLE':
+            raise ValueError('OK cannot be unavailable')
+        if self.availability != 'OK' and not self.reason:
+            raise ValueError('unavailable evidence requires a reason')
+        evidence = object_json(self.evidence_json, 8192)
+        template = self.action_id.split('/')[0]
+        if template not in UNITS or self.action_id != f'{template}/{self.resource_id}/v2':
+            raise ValueError('invalid packet action')
+        # Raw measurements belong in the raw capture store, never paid packets.
+        if self.raw_json != '{}':
+            raise ValueError('v2 packets cannot expose raw collector payloads')
+        if self.availability == 'OK':
+            if evidence.get('units') != UNITS[template]:
+                raise ValueError('measurement units mismatch')
+            integer(evidence.get('sample_count'), 0 if template == 'logs' else 1)
+            if evidence.get('resource_id') != self.resource_id:
+                raise ValueError('measurement resource mismatch')
+            allowed = {
+                'status': {'state'},
+                'cpu': {'median', 'p95', 'high_fraction', 'coverage', 'quota_cores'},
+                'memory': {'median_bytes', 'p95_bytes', 'limit_bytes', 'limit_fraction', 'peak_fraction', 'growth_bytes_per_second', 'growth_span_seconds', 'coverage'},
+                'request_errors': {'operation', 'completed', 'server_errors', 'error_fraction', 'transport_failures', 'attempts', 'semantic_failures', 'transport_fraction', 'achieved_rate_per_second'},
+                'latency': {'operation', 'median_ms', 'p95_ms', 'timeout_count', 'failed_count', 'coverage'},
+                'logs': {'peers', 'event_counts', 'truncated', 'lines', 'warnings', 'max_lines', 'max_bytes'},
+            }[template] | {'units', 'sample_count', 'resource_id'}
+            if set(evidence) - allowed:
+                raise ValueError('packet reveals undeclared evidence fields')
+            required = {
+                'status': {'state'},
+                'cpu': {'median', 'p95', 'high_fraction', 'coverage', 'quota_cores'},
+                'memory': {'median_bytes', 'p95_bytes', 'limit_bytes', 'limit_fraction', 'peak_fraction', 'growth_bytes_per_second', 'growth_span_seconds', 'coverage'},
+                'request_errors': {'operation', 'completed', 'server_errors', 'transport_failures', 'attempts', 'semantic_failures', 'achieved_rate_per_second'},
+                'latency': {'operation', 'median_ms', 'p95_ms', 'timeout_count', 'failed_count', 'coverage'},
+                'logs': {'peers', 'event_counts', 'truncated', 'lines', 'warnings', 'max_lines', 'max_bytes'},
+            }[template]
+            if not required <= set(evidence):
+                raise ValueError('packet omits required measurement fields')
+            fractions = {'high_fraction', 'coverage', 'limit_fraction', 'peak_fraction', 'error_fraction', 'transport_fraction'}
+            integers = {'median_bytes', 'p95_bytes', 'limit_bytes', 'completed', 'server_errors', 'transport_failures', 'timeout_count', 'attempts', 'semantic_failures', 'failed_count', 'max_lines', 'max_bytes'}
+            for name in set(evidence) - {'units', 'sample_count', 'resource_id', 'state', 'operation', 'peers', 'event_counts', 'truncated', 'lines', 'warnings'}:
+                if name in integers:
+                    integer(evidence[name], 1 if name == 'limit_bytes' else 0)
+                else:
+                    real(evidence[name], 0, 1 if name in fractions - {'limit_fraction', 'peak_fraction'} else None)
+            if 'quota_cores' in evidence and evidence['quota_cores'] == 0:
+                raise ValueError('CPU quota must be positive')
+            if template in {'cpu', 'memory'} and (evidence['coverage'] < .8 or evidence['sample_count'] < max(2, math.ceil((timestamp(self.window_end)-timestamp(self.window_start)).total_seconds()*.8/2))):
+                raise ValueError('insufficient container measurement coverage')
+            if template == 'latency' and evidence['sample_count'] < 20:
+                raise ValueError('insufficient successful latency samples')
+            if template == 'status':
+                state = evidence['state']
+                expected = 'RUNNING' if state == 'running' else 'STOPPED' if state in {'exited', 'dead'} else 'OTHER_STATE'
+                if type(state) is not str or self.response_code != expected:
+                    raise ValueError('state and response disagree')
+            if template in {'request_errors', 'latency'} and evidence.get('operation') != 'checkout':
+                raise ValueError('measurement operation mismatch')
+            if template == 'request_errors' and ('completed' not in evidence or
+                    evidence.get('server_errors', 0) > evidence['completed']):
+                raise ValueError('invalid completed request denominator')
+            if template == 'request_errors':
+                attempts = evidence.get('attempts', evidence['completed'] + evidence.get('transport_failures', 0))
+                if attempts != evidence['completed'] + evidence.get('transport_failures', 0):
+                    raise ValueError('invalid request attempt denominator')
+                if 'error_fraction' in evidence and evidence['completed'] < 20:
+                    raise ValueError('insufficient HTTP denominator')
+                if 'transport_fraction' in evidence and attempts < 20:
+                    raise ValueError('insufficient transport denominator')
+                if evidence['semantic_failures'] > evidence['completed'] or attempts < 20:
+                    raise ValueError('invalid request counts')
+                if evidence['completed'] >= 20 and 'error_fraction' not in evidence or 'transport_fraction' not in evidence:
+                    raise ValueError('request fraction missing for valid denominator')
+                if 'error_fraction' in evidence and abs(evidence['error_fraction'] - evidence['server_errors'] / evidence['completed']) > 1e-9:
+                    raise ValueError('HTTP fraction disagrees with counts')
+                if abs(evidence['transport_fraction'] - evidence['transport_failures'] / attempts) > 1e-9:
+                    raise ValueError('transport fraction disagrees with counts')
+            if template == 'logs':
+                peers = evidence.get('peers', [])
+                if type(peers) is not list or len(peers) != len(set(peers)):
+                    raise ValueError('invalid log peers')
+                for peer in peers:
+                    identifier(peer)
+                counts = evidence.get('event_counts', {})
+                if type(counts) is not dict:
+                    raise ValueError('invalid event counts')
+                for key, count in counts.items():
+                    identifier(key)
+                    integer(count)
+                if 'truncated' in evidence and type(evidence['truncated']) is not bool:
+                    raise ValueError('invalid truncation flag')
+                for field in ('lines', 'warnings'):
+                    values = evidence.get(field, [])
+                    if type(values) is not list or len(values) > 20 or any(type(v) is not str for v in values):
+                        raise ValueError('invalid bounded log text')
+                if len(canonical(evidence.get('lines', [])).encode()) > 7000:
+                    raise ValueError('log explanation exceeds packet bound')
+                if evidence['max_lines'] != 20 or evidence['max_bytes'] != 8192 or len(evidence['lines']) != evidence['sample_count']:
+                    raise ValueError('log bounds or sample count changed')
+        elif evidence:
+            raise ValueError('unavailable packet cannot reveal measurements')
diff --git a/team-graph-rca/src/rca_live/streaming.py b/team-graph-rca/src/rca_live/streaming.py
new file mode 100644
index 0000000..33ebd26
--- /dev/null
+++ b/team-graph-rca/src/rca_live/streaming.py
@@ -0,0 +1,218 @@
+"""Rolling physical measurements and explicitly declared short-window readiness."""
+from collections import deque
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from threading import Event, Lock, Thread
+from time import monotonic
+import copy
+import json
+import requests
+from rca_investigation.contracts import IncidentPublic, timestamp, digest
+from rca_investigation.contracts_v2 import IncidentPublicV2, sha256, PROFILES
+from rca_investigation.encoding import encode_packet
+from .agents import PaidWindowBackend
+
+PROTOCOL = {'name':'rolling_early_r3','maximum_incident_seconds':120,'buffer_seconds':180,
+            'cpu_minimum_seconds':10,'memory_pressure_minimum_seconds':15,
+            'memory_normal_minimum_seconds':90,'requests_minimum_seconds':15,'minimum_requests':20,
+            'minimum_confidence':.90,'status_confirmations':2,'maximum_status_age_seconds':6,
+            'maximum_packet_age_seconds':15,'poll_seconds':2,'benchmark_equivalent':False,
+            'exclude_cross_boundary_polls':True,'memory_growth_minimum_span_seconds':90,
+            'status_probes':'confirmed_crash_alerts_only','direct_resource_alerts_before_checkout_symptoms':True,
+            'stale_evidence_refresh':'charged_again_latest_symbol_replaces_old'}
+PROTOCOL_HASH = digest(PROTOCOL)
+
+
+def utcnow():
+    return datetime.now(timezone.utc).isoformat()
+
+
+@dataclass(frozen=True)
+class ShortIncident(IncidentPublicV2):
+    """Live-only temporal contract. Never serialized into a benchmark dataset."""
+    def __post_init__(self):
+        IncidentPublic.__post_init__(self)
+        if self.schema_version != 2 or self.task_id not in PROFILES or self.alert_context_json != '{}':
+            raise ValueError('unsupported short live incident')
+        for value in (self.encoding_hash,self.objective_hash):
+            sha256(value)
+        if not 0 < (timestamp(self.window_end)-timestamp(self.window_start)).total_seconds() <= 120:
+            raise ValueError('short live window must be real and at most 120 seconds')
+
+
+class RollingCollector:
+    def __init__(self, driver, workload, stats):
+        self.driver,self.workload,self.stats = driver,workload,stats
+        self.guard,self.stop = Lock(),Event()
+        self.states,self.samples,self.requests,self.errors = (deque(maxlen=n) for n in (300,3000,3000,500))
+        self.threads = []
+        self.started = utcnow()
+        self.failure = None
+
+    def __enter__(self):
+        self.workload.prepare()
+        self.workload.measure_cart = False
+        self.threads = [Thread(target=self._status_stats,name='rolling-status-stats'),
+                        Thread(target=self._traffic,name='rolling-checkout')]
+        try:
+            for thread in self.threads:
+                thread.start()
+        except BaseException:
+            self.__exit__(None,None,None)
+            raise
+        return self
+
+    def __exit__(self,*args):
+        self.stop.set()
+        for thread in self.threads:
+            if thread.ident is not None:
+                thread.join(timeout=40)
+        if any(thread.is_alive() for thread in self.threads):
+            raise RuntimeError('rolling collector did not stop; do not release lab ownership')
+
+    def _status_stats(self):
+        try:
+            while not self.stop.is_set():
+                start = monotonic()
+                observation_started = utcnow()
+                states = self.driver.states()
+                sample_time = utcnow()
+                with self.guard:
+                    self.states.append({'sample_time':sample_time,'states':states,'observation_started_at':observation_started})
+                poll_started = utcnow()
+                rows = self.stats.poll()
+                with self.guard:
+                    rows = [{**r,'observation_started_at':poll_started} for r in rows]
+                    self.samples.extend(rows)
+                    self._prune()
+                self.stop.wait(max(.05,2-(monotonic()-start)))
+        except Exception as exc:
+            self.failure = type(exc).__name__
+            self.stop.set()
+
+    def _traffic(self):
+        while not self.stop.is_set():
+            started = utcnow()
+            try:
+                row = self.workload.checkout()
+                row['request_started_at'] = started
+                with self.guard:
+                    self.requests.append(row)
+                    self._prune()
+            except (RuntimeError,requests.RequestException) as exc:
+                with self.guard:
+                    self.errors.append({'sample_time':utcnow(),'request_started_at':started,'reason':type(exc).__name__})
+            self.stop.wait(.1)
+
+    def _prune(self):
+        from datetime import timedelta
+        boundary = timestamp(utcnow())-timedelta(seconds=PROTOCOL['buffer_seconds'])
+        for rows in (self.states,self.samples,self.requests,self.errors):
+            while rows and timestamp(rows[0]['sample_time'])<boundary:
+                rows.popleft()
+
+    def snapshot(self, since, end=None):
+        if self.failure:
+            raise RuntimeError('rolling collector failed: '+self.failure)
+        end = end or utcnow()
+        start,finish = timestamp(since),timestamp(end)
+        if finish <= start:
+            raise ValueError('rolling window must have elapsed')
+        with self.guard:
+            def selected(rows):
+                return [copy.deepcopy(row) for row in rows if start <= timestamp(row['sample_time']) <= finish
+                        and timestamp(row.get('request_started_at',row.get('observation_started_at',row['sample_time']))) >= start]
+            states = selected(self.states)
+            raw = {'stats':selected(self.samples),'requests':selected(self.requests),'status':{},
+                   'workload_errors':selected(self.errors),'logs':{},'collected_at':end}
+        if states:
+            last = states[-1]
+            raw['status'] = {r:{'resource':r,'state':value,'container_id':self.driver.ids[r],
+                                'sample_time':last['sample_time']} for r,value in last['states'].items()}
+        raw['status_observations'] = states
+        return {'window_start':since,'window_end':end},raw
+
+    def baseline(self):
+        now = timestamp(utcnow())
+        from datetime import timedelta
+        since = max(timestamp(self.started),now-timedelta(seconds=30)).isoformat()
+        window,raw = self.snapshot(since,now.isoformat())
+        rows = [r for r in raw['requests'] if r['operation']=='checkout']
+        states = raw['status_observations']
+        good = len(rows)>=20 and not raw['workload_errors'] and all(r['http_status']==201 and r['outcome']=='completed' for r in rows)
+        good = good and len(states)>=2 and all(v=='running' for v in states[-1]['states'].values())
+        good = good and (now-timestamp(states[-1]['sample_time'])).total_seconds()<=6 if states else False
+        return good,window,raw
+
+
+class PrefixBackend(PaidWindowBackend):
+    """Apply fixed encoder boundaries only when short-window support is adequate."""
+    version = 'rolling_prefix_r3'
+    def execute(self,spec):
+        duration = (timestamp(self.incident.window_end)-timestamp(self.incident.window_start)).total_seconds()
+        reason = None
+        if spec.template == 'status':
+            rows = self.raw.get('status_observations',[])
+            row = self.raw.get('status',{}).get(spec.resource_id)
+            confirmed = len(rows)>=2 and all(r['states'].get(spec.resource_id)==row['state'] for r in rows[-2:]) if row else False
+            if not confirmed or (timestamp(self.incident.window_end)-timestamp(row['sample_time'])).total_seconds()>6:
+                reason = 'waiting_for_fresh_status_confirmation'
+        elif spec.template == 'cpu' and duration<10:
+            reason = 'cpu_prefix_too_short'
+        elif spec.template == 'memory' and duration<15:
+            reason = 'memory_prefix_too_short'
+        elif spec.template in ('request_errors','latency') and (duration<15 or len(self.raw['requests'])<20):
+            reason = 'waiting_for_twenty_post_alert_requests'
+        elif spec.template == 'logs':
+            reason = 'logs_not_ready_in_short_window'
+        if reason:
+            return encode_packet(spec,self.incident,('NO_DATA','UNAVAILABLE',{},reason),self.version,collected_at=self.raw['collected_at'])
+        if spec.template in ('cpu','memory'):
+            from rca_investigation.metrics import cpu,memory
+            from rca_investigation.contracts import canonical
+            from .short_packets import ShortPacket
+            rows = [r for r in self.raw['stats'] if r['resource_id']==spec.resource_id]
+            item = self.registry[spec.resource_id]
+            values = self.encoder.values
+            thresholds = values['thresholds']
+            custom = values.get('thresholds_by_resource',{})
+            if spec.template=='cpu':
+                threshold = custom.get('cpu',{}).get(spec.resource_id,thresholds['cpu'])
+                summary = cpu.summarize(rows,spec.resource_id,item['container_id'],item['cpu_quota_cores'],
+                    self.incident.window_start,self.incident.window_end,threshold)
+            else:
+                pressure = custom.get('memory',{}).get(spec.resource_id,thresholds['memory'])
+                growth = custom.get('memory_growth',{}).get(spec.resource_id,thresholds['memory_growth'])
+                summary = memory.summarize(rows,spec.resource_id,item['container_id'],item['memory_limit_bytes'],
+                    self.incident.window_start,self.incident.window_end,pressure=pressure,growth=growth)
+            availability,code,evidence,why = summary
+            packet = ShortPacket(spec.action_id,spec.resource_id,availability,code,self.incident.window_start,self.incident.window_end,
+                self.incident.window_end,self.version,0,collected_at=self.raw['collected_at'],encoding_hash=spec.encoding_hash,
+                evidence_json=canonical(evidence),reason=why)
+            packet.validate_context(spec,self.incident)
+        else:
+            packet = super().execute(spec)
+        memory_span = json.loads(packet.evidence_json).get('growth_span_seconds',0) if spec.template=='memory' else 0
+        if spec.template=='memory' and (duration<90 or memory_span<90) and packet.response_code not in ('PRESSURE','PRESSURE_AND_GROWTH','UNAVAILABLE'):
+            return encode_packet(spec,self.incident,('NO_DATA','UNAVAILABLE',{},'normal_memory_requires_growth_observation'),self.version,collected_at=self.raw['collected_at'])
+        return packet
+
+
+def incident_for(agents,identifier,window):
+    from rca_investigation.catalogue import catalogue_hash
+    return ShortIncident(identifier,agents.topology.hash,catalogue_hash(agents.specs),'front-end','manual_frontend',
+        window['window_start'],window['window_end'],10,5,agents.config.values['objective']['lambda_cost'],
+        task_id=agents.config.values['task_id'],encoding_hash=agents.encoder.hash,
+        objective_hash=digest(agents.config.values['objective']))
+
+
+def prefix_packets(agents,identifier,window,raw,registry):
+    backend = PrefixBackend(agents.specs,raw,registry,agents.topology,agents.encoder)
+    incident = incident_for(agents,identifier,window)
+    backend.begin(incident)
+    try:
+        packets = [backend.execute(spec) for spec in agents.specs]
+    finally:
+        backend.close()
+    ready = {p.action_id for p in packets if p.availability=='OK'}
+    return incident,packets,ready
diff --git a/team-graph-rca/tests/test_live_bootstrap.py b/team-graph-rca/tests/test_live_bootstrap.py
new file mode 100644
index 0000000..d144201
