index 0000000..0e92971
--- /dev/null
+++ b/team-graph-rca/src/rca_live/cli.py
@@ -0,0 +1,133 @@
+"""Three-terminal entry points for the live demonstration."""
+import argparse
+import json
+from pathlib import Path
+import threading
+from time import sleep
+from .agents import POLICIES
+from .bus import read_events, request
+from .controller import Controller
+from .narration import Narrator
+from .repair import CASES
+from .display import render
+from rca_investigation.dataset import atomic_json
+
+
+def chat(args):
+    env_file = args.env_file or (Path('pipeline/.env') if Path('pipeline/.env').exists() else None)
+    narrator = Narrator(env_file, enabled=not args.no_llm)
+    path = Path(args.output) / 'events.jsonl'
+    offset = 0 if args.history else path.stat().st_size if path.exists() else 0
+    stopped = threading.Event()
+    print('Chat explains agent output. Commands: policy voi|dp|expected-sarsa|two-step-sarsa, status, stop, quit.', flush=True)
+    def watch():
+        nonlocal offset
+        while not stopped.is_set():
+            rows, offset = read_events(args.output, offset)
+            for row in rows:
+                kind, value = row['kind'], row['payload']
+                if kind == 'probe':
+                    print(render(kind, value), flush=True)
+                elif kind == 'complete':
+                    answer = narrator.describe(value)
+                    print('\n' + answer['authoritative'], flush=True)
+                    if answer['commentary']:
+                        print('LLM explanation: ' + answer['commentary'], flush=True)
+                    else:
+                        print('Narration mode: ' + answer['mode'], flush=True)
+                    atomic_json(Path(args.output) / 'narration' / (value['incident_id'] + '.json'), answer)
+                    if args.once:
+                        stopped.set()
+                        return
+                elif kind in ('ready','rolling','graph','diagnosis','monitor', 'repair', 'cleanup', 'policy', 'failure', 'request_failed', 'stopped'):
+                    print(render(kind, value), flush=True)
+            stopped.wait(.25)
+    worker = threading.Thread(target=watch, daemon=True)
+    worker.start()
+    try:
+        if args.once or args.watch:
+            while not stopped.wait(.25):
+                pass
+        else:
+            while not stopped.is_set():
+                words = input('chat> ').strip().lower().split()
+                if words == ['quit']:
+                    break
+                if words == ['stop']:
+                    print('Queued stop at the next safe incident boundary: ' + request(args.output, 'stop'))
+                elif len(words) == 2 and words[0] == 'policy' and words[1] in POLICIES:
+                    print('Queued policy: ' + request(args.output, 'policy', policy=words[1]))
+                elif words == ['status']:
+                    events, _ = read_events(args.output, 0)
+                    print(render(events[-1]['kind'], events[-1]['payload']) if events else 'No events yet.')
+                else:
+                    print('Use policy NAME, status, stop or quit. Natural-language output comes from the narrator.')
+    finally:
+        stopped.set()
+        worker.join(timeout=25)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', default='runs/live_demo')
+    commands = parser.add_subparsers(dest='command', required=True)
+    serve = commands.add_parser('serve')
+    serve.add_argument('--artifacts', required=True, help='Original repository holding immutable v2 models and checkpoints')
+    serve.add_argument('--once', action='store_true')
+    serve.add_argument('--collection',choices=('rolling','windowed'),default='rolling')
+    single = commands.add_parser('run')
+    single.add_argument('--artifacts', required=True)
+    single.add_argument('--case', choices=tuple(CASES), required=True)
+    single.add_argument('--policy', choices=POLICIES, default='voi')
+    single.add_argument('--seed', type=int, choices=(11,22,33,44,55), default=11)
+    single.add_argument('--hybrid', action='store_true')
+    single.add_argument('--collection',choices=('rolling','windowed'),default='rolling')
+    injector = commands.add_parser('inject')
+    injector.add_argument('--case', choices=tuple(CASES))
+    viewer = commands.add_parser('chat')
+    viewer.add_argument('--env-file')
+    viewer.add_argument('--no-llm', action='store_true')
+    viewer.add_argument('--once', action='store_true')
+    viewer.add_argument('--history', action='store_true')
+    viewer.add_argument('--watch', action='store_true')
+    commands.add_parser('stop')
+    recovery = commands.add_parser('recover')
+    recovery.add_argument('--artifacts', required=True)
+    args = parser.parse_args(argv)
+    controller_type = Controller
+    if args.command in ('serve','run') and args.collection=='rolling':
+        from .rolling_controller import RollingController
+        controller_type = RollingController
+    if args.command == 'serve':
+        controller_type(args.artifacts, args.output).serve(args.once)
+    elif args.command == 'run':
+        from .bus import server_lock
+        with server_lock(args.output):
+            controller_type(args.artifacts, args.output).run({'id': request_id(), 'command': 'run',
+                'case': args.case, 'policy': args.policy, 'seed': args.seed, 'hybrid': args.hybrid})
+    elif args.command == 'chat':
+        chat(args)
+    elif args.command == 'stop':
+        print(request(args.output, 'stop'))
+    elif args.command == 'recover':
+        from .recovery import recover
+        print(json.dumps(recover(args.artifacts, args.output)))
+    else:
+        if not (Path(args.output) / 'server.lock').exists():
+            parser.error('start Terminal 1 controller first')
+        if args.case:
+            print('Queued incident ' + request(args.output, 'run', case=args.case))
+        else:
+            cases = tuple(CASES)
+            while True:
+                print('\n' + '\n'.join(f'{i+1}. {name}' for i, name in enumerate(cases)) + '\nq. Quit injector')
+                choice = input('Fault> ').strip()
+                if choice.lower() == 'q':
+                    return
+                if choice.isdigit() and 1 <= int(choice) <= len(cases):
+                    print('Queued incident ' + request(args.output, 'run', case=cases[int(choice)-1]))
+
+
+def request_id():
+    from uuid import uuid4
+    return str(uuid4())
