+def test_partial_collector_start_failure_stops_started_worker(monkeypatch):
+    import rca_live.streaming as module
+    workers=[]
+    class FakeThread:
+        def __init__(self,**kwargs):
+            self.ident=None
+            self.running=False
+            workers.append(self)
+        def start(self):
+            if self is workers[1]:
+                raise RuntimeError('worker failed to start')
+            self.ident=1
+            self.running=True
+        def join(self,**kwargs):
+            self.running=False
+        def is_alive(self):
+            return self.running
+    monkeypatch.setattr(module,'Thread',FakeThread)
+    collector=RollingCollector(None,SimpleNamespace(prepare=lambda:None),None)
+    with pytest.raises(RuntimeError,match='failed to start'):
+        collector.__enter__()
+    assert collector.stop.is_set() and not workers[0].is_alive()
