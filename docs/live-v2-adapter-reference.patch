@@ -0,0 +1,80 @@
+"""Saved validation prefixes assess readiness, not fresh alert-to-repair latency."""
+import argparse
+import json
+from pathlib import Path
+import sys
+from datetime import timedelta
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'src'))
+from rca_live.bootstrap import activate
+activate()
+from rca_live.agents import Agents,POLICIES
+from rca_live.graph import GraphEvidenceBackend,anomaly
+from rca_live.progressive import ProgressiveSession
+from rca_live.streaming import prefix_packets,PROTOCOL,PROTOCOL_HASH
+from rca_investigation.contracts import timestamp,digest
+from rca_investigation.capture_store import read_raw
+from rca_investigation.dataset import atomic_json,load_private_label
+from rca_investigation.experiment import label_name
+
+
+class LocalGraph:
+    """Exercise the actual graph packet decoder without writing to the occupied lab."""
+    def __init__(self,agents,identifier,window,packets):
+        self.topology=agents.topology
+        self.context={'incident_id':identifier,'window':window,'collection_protocol':PROTOCOL['name'],
+            'anomalies':[{'name':p.resource_id,'anomaly_type':anomaly(p)} for p in packets if anomaly(p)]}
+        self.rows={p.action_id:{'packet':p.to_json(),'hash':digest(p.to_dict())} for p in packets}
+        self.graph=self
+    def query(self,query,params=None):
+        return [self.rows[params['action']]]
+    def backend(self,specs,registry,encoder):
+        return GraphEvidenceBackend(self,specs,registry,encoder)
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--artifacts',required=True)
+    args=parser.parse_args()
+    root=Path(args.artifacts)
+    agents=Agents(root)
+    output=Path('runs/early_mode_verification')/PROTOCOL['name']
+    atomic_json(output/'protocol.json',{'protocol':PROTOCOL,'hash':PROTOCOL_HASH})
+    dataset=root/agents.config.values['paths']['dataset']
+    splits=json.loads((dataset/'splits.json').read_text())
+    cases={}
+    for identifier in splits['splits']['validation']:
+        cases.setdefault(label_name(load_private_label(dataset/identifier)),identifier)
+    checks=[]
+    for truth,identifier in sorted(cases.items()):
+        data,_=read_raw(root/'datasets/raw_v2c'/identifier,public_only=True)
+        window,raw=data['public.json'],data['measurements.json']
+        start=timestamp(window['window_start'])
+        for name in POLICIES:
+            session=ProgressiveSession(agents,identifier,name)
+            result=None
+            for seconds in (5,10,15,30,60,90,120):
+                end=start+timedelta(seconds=seconds)
+                selected=lambda rows:[r for r in rows if start<=timestamp(r['sample_time'])<=end]
+                prefix={'stats':selected(raw['stats']),'requests':selected(raw['requests']),
+                    'workload_errors':selected(raw['workload_errors']),'logs':{},'status':{},
+                    'status_observations':[],'collected_at':end.isoformat()}
+                # Saved v2 captures contain only one status snapshot. Do not invent
+                # the second confirmation or extrapolate status into the future.
+                public={'window_start':start.isoformat(),'window_end':end.isoformat()}
+                incident,packets,ready=prefix_packets(agents,identifier,public,prefix,raw['registry'])
+                graph=LocalGraph(agents,identifier,public,packets)
+                result=session.advance(incident,graph,ready,end.isoformat(),deadline=seconds==120)
+                if result:
+                    break
+            row={'truth':truth,'policy':name,'prediction':result['decision']['prediction'],
+                 'correct':result['decision']['prediction']==truth,'decision_prefix_seconds':seconds,
+                 'probes':result['probes'],'credits':result['credits'],'mode':'saved_prefix_engineering_check'}
+            checks.append(row)
+            print(json.dumps(row),flush=True)
+    atomic_json(output/'prefix-results.json',{'checks':checks,'protocol_hash':PROTOCOL_HASH,
+        'physical_injections':0,'neo4j_writes':0,'training':False,'reserved_reads':False,
+        'benchmark_equivalent':False,'limit':'Saved captures start after settling and lack repeat status snapshots. Prefix duration is not fresh incident detection or repair latency.'})
+
+
+if __name__=='__main__':
+    main()
