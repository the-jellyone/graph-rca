@@ -0,0 +1,53 @@
+"""A changed snapshot, materialized module or topology cannot load silently."""
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def activate(root):
+    program = 'from rca_live.bootstrap import activate; activate(' + repr(str(root)) + '); print("verified")'
+    return subprocess.run([sys.executable,'-c',program],capture_output=True,text=True,timeout=15)
+
+
+def fixture(root):
+    snapshot = Path('benchmarks/adaptive_v2/v2c_memory_separation_r1/source-snapshot.json')
+    (root/snapshot).parent.mkdir(parents=True)
+    shutil.copyfile(ROOT/snapshot, root/snapshot)
+    topology = root/'src/rca_investigation/sockshop_topology.json'
+    topology.parent.mkdir(parents=True)
+    shutil.copyfile(ROOT/'src/rca_investigation/sockshop_topology.json', topology)
+    return snapshot, topology
+
+
+def test_materialized_source_and_topology_are_verified(tmp_path):
+    _, topology = fixture(tmp_path)
+    first = activate(tmp_path)
+    assert first.returncode == 0, first.stderr
+    assert activate(tmp_path).returncode == 0
+    module = next((tmp_path/'runs/live_demo_runtime').glob('*/rca_investigation/environment.py'))
+    module.write_text(module.read_text()+'\n# changed\n')
+    failure = activate(tmp_path)
+    assert failure.returncode != 0 and 'materialized frozen source changed' in failure.stderr
+
+
+def test_changed_snapshot_is_rejected_before_materializing(tmp_path):
+    snapshot, _ = fixture(tmp_path)
+    payload = json.loads((tmp_path/snapshot).read_text())
+    payload['files']['environment.py'] += '\n# changed\n'
+    (tmp_path/snapshot).write_text(json.dumps(payload))
+    failure = activate(tmp_path)
+    assert failure.returncode != 0 and 'snapshot identity changed' in failure.stderr
+    assert not (tmp_path/'runs').exists()
+
+
+def test_changed_topology_is_rejected(tmp_path):
+    _, topology = fixture(tmp_path)
+    payload = json.loads(topology.read_text())
+    payload['version'] = 'changed'
+    topology.write_text(json.dumps(payload))
+    failure = activate(tmp_path)
+    assert failure.returncode != 0 and 'live topology changed' in failure.stderr
