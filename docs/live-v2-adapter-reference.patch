@@ -0,0 +1,58 @@
+"""Public raw projection must reproduce the frozen validation replay exactly."""
+from pathlib import Path
+import argparse
+import json
+import sys
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
+from rca_live.bootstrap import activate
+activate()
+from rca_live.agents import Agents, POLICIES
+from rca_investigation.capture_store import read_raw
+from rca_investigation.dataset import atomic_json, load_private_label
+from rca_investigation.experiment import label_name, replay_environment
+from rca_investigation.comparison import policy_from_definition, policy_identity
+from rca_investigation.evaluate_decisions import investigate
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--artifacts', required=True)
+    args = parser.parse_args()
+    root = Path(args.artifacts)
+    agents = Agents(root)
+    dataset = root / agents.config.values['paths']['dataset']
+    manifest = json.loads((dataset / 'splits.json').read_text())
+    samples = {}
+    # These labels select illustrative VALIDATION cases only. No fitting or reserved reads.
+    for identifier in manifest['splits']['validation']:
+        cause = label_name(load_private_label(dataset / identifier))
+        samples.setdefault(cause, identifier)
+    rows = []
+    for cause, identifier in sorted(samples.items()):
+        public, _ = read_raw(root / 'datasets/raw_v2c' / identifier, public_only=True)
+        raw = public['measurements.json']
+        window = public['public.json']
+        for name in POLICIES:
+            live = agents.investigate(identifier, window, raw, raw['registry'], policy=name, mode='offline_adapter_check')
+            key = live['policy']
+            definition = agents.frozen['definitions'][key]
+            policy = policy_from_definition(definition, agents.model, agents.specs, agents.config)
+            env = replay_environment(dataset / identifier, agents.specs, agents.model, agents.config)
+            try:
+                replay = investigate(env, policy, policy_identity(definition, agents.model, agents.config))
+            finally:
+                env.close()
+            # Include packet byte identity, trace order, costs and decision. Timing can vary.
+            matched = live['decision'] == replay['decision'] and live['packets'] == replay['packets'] and live['credits'] == replay['credits'] and [t['action'] for t in live['trace']] == [t['action'] for t in replay['trace']]
+            row = {'case': cause, 'policy': key, 'matched_frozen_replay': matched, 'prediction': live['decision']['prediction'],
+                   'probes': live['probes'], 'credits': live['credits'], 'mode': 'offline_adapter_check'}
+            rows.append(row)
+            print(json.dumps(row), flush=True)
+            if not matched:
+                raise AssertionError('live adapter changed frozen evidence or behavior')
+    atomic_json('runs/live_demo_verification/adapter.json', {'checks': rows, 'passed': all(r['matched_frozen_replay'] for r in rows),
+        'physical_injections': 0, 'training': False, 'reserved_reads': False, 'identity': agents.identity})
+
+
+if __name__ == '__main__':
+    main()
