@@ -0,0 +1,68 @@
+"""Materialize the committed v2 snapshot without importing or changing v3 code."""
+import hashlib
+import json
+from pathlib import Path, PureWindowsPath, PurePosixPath
+import sys
+from uuid import uuid4
+
+RUNTIME = '54322988ac5c35261153217f092d07d4a261dfe36d76098870652f824ad9ef46'
+SNAPSHOT = '8e7d72a72495350dbfc97f3ac1d47d652623276c3a3c243038ffb388751fa6c2'
+TOPOLOGY = 'a0e40030c8ff173df204e6f0889b480b11f4b34017f920f964c3a38f1e68e632'
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False).encode()).hexdigest()
+
+
+def activate(root=None):
+    root = Path(root).resolve() if root else Path(__file__).resolve().parents[2]
+    payload = json.loads((root/'benchmarks/adaptive_v2/v2c_memory_separation_r1/source-snapshot.json').read_text(encoding='utf-8'))
+    claimed = payload.pop('hash')
+    files = payload['files']
+    if claimed != SNAPSHOT or digest(payload) != claimed or payload['runtime_hash'] != RUNTIME:
+        raise ValueError('frozen v2 snapshot identity changed')
+    if digest({name: digest(source) for name, source in files.items()}) != RUNTIME:
+        raise ValueError('frozen v2 source hash mismatch')
+    for name in files:
+        if any(p.is_absolute() or '..' in p.parts for p in (PureWindowsPath(name), PurePosixPath(name))) or not name.endswith('.py'):
+            raise ValueError('unsafe frozen source path')
+    parent = root/'runs/live_demo_runtime'/RUNTIME
+    target = parent/'rca_investigation'
+    if not target.exists():
+        parent.mkdir(parents=True, exist_ok=True)
+        staged = parent/('pending-'+str(uuid4()))
+        staged.mkdir()
+        for name, source in files.items():
+            path = staged/name.replace('\\','/')
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(source, encoding='utf-8', newline='')
+        try:
+            staged.rename(target)
+        except FileExistsError:
+            # Another terminal may have published the same immutable source first.
+            import shutil
+            shutil.rmtree(staged)
+    observed = {str(p.relative_to(target)): p.read_text(encoding='utf-8') for p in target.rglob('*.py')}
+    # Canonical Windows paths preserve the original source identity on every host.
+    expected = {str(PureWindowsPath(name)): source for name, source in files.items()}
+    actual = {str(PureWindowsPath(name)): source for name, source in observed.items()}
+    if actual != expected:
+        raise ValueError('materialized frozen source changed')
+    topology = json.loads((root/'src/rca_investigation/sockshop_topology.json').read_text(encoding='utf-8'))
+    if digest(topology) != TOPOLOGY:
+        raise ValueError('frozen live topology changed')
+    topology_path = target/'sockshop_topology.json'
+    if topology_path.exists():
+        if digest(json.loads(topology_path.read_text(encoding='utf-8'))) != TOPOLOGY:
+            raise ValueError('materialized topology changed')
+    else:
+        # Atomic publication also supports several terminals starting together.
+        temporary = target/('topology-'+str(uuid4())+'.pending')
+        temporary.write_text(json.dumps(topology), encoding='utf-8')
+        temporary.replace(topology_path)
+    if 'rca_investigation' in sys.modules:
+        location = Path(sys.modules['rca_investigation'].__file__).resolve()
+        if not location.is_relative_to(target):
+            raise RuntimeError('another investigation runtime was already imported')
+    sys.path.insert(0, str(parent))
+    return target
