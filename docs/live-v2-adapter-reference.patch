+"""Graph anomalies guide probes; graph heuristics never authorize repair."""
+from types import SimpleNamespace
+import pytest
+from rca_live.graph import GraphGuidedPolicy, GraphRAG, GraphEvidenceBackend, ScopedGraph, anomaly
+from rca_live.repair import repair_allowed
+from rca_investigation.topology import sockshop_topology
+
+
+def test_graph_stopped_resource_is_checked_before_downstream_latency():
