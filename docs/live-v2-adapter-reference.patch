+class FakeGraph:
+    def __init__(self,agents,packets):
+        self.topology=agents.topology
+        self.context={'anomalies':[{'name':'payment','anomaly_type':'cpu_exhaustion,service_crash'}]}
+        self.packets={p.action_id:p for p in packets}
+    def backend(self,*args):
+        return SimpleNamespace(begin=lambda incident:None,execute=lambda spec:self.packets[spec.action_id],close=lambda:None)
