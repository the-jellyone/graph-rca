+"""Existing graph construction and traversal, with incident-scoped paid evidence."""
+from contextlib import redirect_stdout
+import io
+import json
+import re
+from pathlib import Path
+from rca_investigation.contracts import TopologySnapshot, digest
+from rca_investigation.contracts_v2 import ToolResultV2
+from .agents import PaidWindowBackend
+from .legacy_graph.kg_builder import KGBuilder
+from .legacy_graph.retriever import get_active_anomalies, dynamic_expansion
+from .legacy_graph.graph_writer import writer_lease
+
+
+class ScopedGraph:
+    """Existing Cypher retrieval operates only on this demo's graph projection."""
+    def __init__(self, graph):
+        self.inner = graph
+    def query(self, query, params=None):
+        # All node variables used by the copied builder/retriever are enumerated.
+        # Restrict both endpoints, including traversal queries and relationship cleanup.
+        seen = set()
+        def scope(match):
+            variable = match.group(1)
+            if variable in seen:
+                return '('+variable
+            seen.add(variable)
+            label = 'LiveDemoEvidence' if variable == 'e' else 'LiveDemoResource'
+            return '('+variable+':'+label
+        query = re.sub(r'\((n|a|b|curr|nbr|e)(?=[\s:{)])',scope,query)
+        return self.inner.query(query,params=params)
+    def close(self):
+        self.inner.close()
+
+
+def anomaly(packet):
+    if packet.availability != 'OK':
+        return None
+    family = packet.action_id.split('/')[0]
+    evidence = json.loads(packet.evidence_json)
+    if family == 'status' and packet.response_code == 'STOPPED':
+        return 'service_crash'
+    if family == 'cpu' and packet.response_code == 'HIGH':
+        return 'cpu_exhaustion'
+    if family == 'memory' and packet.response_code in ('PRESSURE','PRESSURE_AND_GROWTH'):
+        return 'memory_pressure'
+    if family == 'latency' and packet.response_code == 'SLOW':
+        return 'slow_checkout'
+    if family == 'request_errors' and packet.response_code != 'NORMAL':
+        return 'checkout_failures'
+    return None
+
+
+class GraphRAG:
+    def __init__(self, artifacts, topology):
+        self.artifacts, self.expected = Path(artifacts), topology
+        self.builder = None
+        self.lease = None
+
+    def __enter__(self):
+        self.lease = writer_lease(self.artifacts/'data/graph_writer.lock')
+        self.lease.__enter__()
+        try:
+            with redirect_stdout(io.StringIO()):
+                self.builder = KGBuilder()
+                self.builder.graph = ScopedGraph(self.builder.graph)
+                self.builder.build_initial_graph(reset=False)
+            self.topology = self.read_topology()
+            return self
+        except BaseException:
+            self.__exit__(None,None,None)
+            raise
+
+    def __exit__(self, *args):
+        try:
+            if self.builder:
+                with redirect_stdout(io.StringIO()):
+                    self.builder.close()
+        finally:
+            if self.lease:
+                self.lease.__exit__(*args)
+
+    @property
+    def graph(self):
+        return self.builder.graph
+
+    def read_topology(self):
+        nodes = self.graph.query("MATCH (n {lab_project:'rca-lab'}) RETURN n.name AS name, n.category AS category ORDER BY name")
+        edges = self.graph.query("MATCH (a {lab_project:'rca-lab'})-[:CALLS]->(b {lab_project:'rca-lab'}) RETURN DISTINCT a.name AS source,b.name AS target ORDER BY source,target")
+        topology = TopologySnapshot(self.expected.version, tuple(n['name'] for n in nodes),
+            tuple(n['category'] for n in nodes), tuple((e['source'],e['target']) for e in edges))
+        if topology.hash != self.expected.hash:
+            raise RuntimeError('Neo4j dependencies differ from the trained topology; refusing an incompatible policy')
+        return topology
+
+    def publish(self, identifier, window, raw, registry, agents, packets=None):
+        # Encode the same measured window once, never injector labels or scenario names.
+        from rca_investigation.catalogue import catalogue_hash
+        from rca_investigation.contracts_v2 import IncidentPublicV2
+        objective = agents.config.values['objective']
+        short_window = packets is not None
+        projector = None
+        if packets is None:
+            incident = IncidentPublicV2(identifier, self.topology.hash, catalogue_hash(agents.specs), 'front-end','manual_frontend',
+                window['window_start'],window['window_end'],agents.config.values['episode']['budget'],
+                agents.config.values['episode']['max_probes'],objective['lambda_cost'],task_id=agents.config.values['task_id'],
+                encoding_hash=agents.encoder.hash,objective_hash=digest(objective))
+            projector = PaidWindowBackend(agents.specs,raw,registry,self.topology,agents.encoder)
+            projector.begin(incident)
+            packets = [projector.execute(spec) for spec in agents.specs]
+        else:
+            from .streaming import incident_for
+            incident = incident_for(agents,identifier,window)
